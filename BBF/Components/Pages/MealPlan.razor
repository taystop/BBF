@page "/meal-plan"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using BBF.Data.Entities
@using BBF.Services
@inject MealPlanService MealPlanSvc
@inject RecipeService RecipeSvc
@inject UserContextService UserContext
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>Meal Plan - BBF</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    @if (!UserContext.IsInitialized || UserContext.ActiveGroupId is null)
    {
        <MudPaper Class="pa-6 text-center" Elevation="2">
            <MudText Typo="Typo.h5" Class="mb-2">No Group</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Join or create a group first.</MudText>
        </MudPaper>
    }
    else if (_week is not null)
    {
        <MudStack Row AlignItems="AlignItems.Center" Style="flex-wrap: wrap; gap: 8px;" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h4">Meal Plan</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="@(() => GoToWeek(-7))" />
            <MudText Typo="Typo.subtitle1">
                @_weekStart.ToString("MMM d") - @_weekStart.AddDays(6).ToString("MMM d, yyyy")
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="@(() => GoToWeek(7))" />
            <MudButton Variant="Variant.Outlined" OnClick="@(() => LoadWeek(MealPlanService.GetWeekStart(DateTime.Now)))">
                This Week
            </MudButton>
        </MudStack>

        @if (_recipes.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3">
                No recipes yet. <MudLink Href="/recipes">Add some recipes</MudLink> before planning meals.
            </MudAlert>
        }

        <!-- Desktop: full week grid -->
        <div class="desktop-week-grid">
            <table class="meal-grid">
                <thead>
                    <tr>
                        <th></th>
                        @foreach (var day in Days)
                        {
                            <th>@day.ToString("ddd")<br /><span class="day-date">@day.ToString("MMM d")</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in Slots)
                    {
                        <tr>
                            <th class="slot-label">@slot</th>
                            @foreach (var day in Days)
                            {
                                var date = day;
                                var mealSlot = slot;
                                var entry = GetEntry(date, mealSlot);
                                <td>
                                    @if (entry is not null)
                                    {
                                        <div class="meal-cell filled" @onclick="@(() => OpenPicker(date, mealSlot, entry))">
                                            <MudText Typo="Typo.body2">@entry.Recipe.Name</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@entry.PlannedServings servings</MudText>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="meal-cell empty" @onclick="@(() => OpenPicker(date, mealSlot, null))">
                                            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Secondary" />
                                        </div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile: stacked day cards -->
        <div class="mobile-week-stack">
            @foreach (var day in Days)
            {
                var date = day;
                <MudPaper Class="pa-3 mb-3" Elevation="2">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@date.ToString("dddd, MMM d")</MudText>
                    @foreach (var slot in Slots)
                    {
                        var mealSlot = slot;
                        var entry = GetEntry(date, mealSlot);
                        <MudStack Row AlignItems="AlignItems.Center" Style="flex-wrap: wrap; gap: 8px;" Class="mb-2"
                                  @onclick="@(() => OpenPicker(date, mealSlot, entry))">
                            <MudText Typo="Typo.body2" Style="min-width: 80px;" Color="Color.Secondary">@mealSlot</MudText>
                            @if (entry is not null)
                            {
                                <MudChip T="string" Color="Color.Primary">@entry.Recipe.Name (@entry.PlannedServings)</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Icon="@Icons.Material.Filled.Add" Variant="Variant.Outlined">Add</MudChip>
                            }
                        </MudStack>
                    }
                </MudPaper>
            }
        </div>
    }
</MudContainer>

<style>
    .desktop-week-grid { display: block; }
    .mobile-week-stack { display: none; }

    @@media (max-width: 900px) {
        .desktop-week-grid { display: none; }
        .mobile-week-stack { display: block; }
    }

    .meal-grid { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .meal-grid th, .meal-grid td { border: 1px solid var(--mud-palette-lines-default); padding: 4px; vertical-align: top; }
    .meal-grid thead th { text-align: center; padding: 8px 4px; }
    .day-date { font-weight: normal; font-size: 0.75rem; color: var(--mud-palette-text-secondary); }
    .slot-label { text-align: left; padding-left: 8px; white-space: nowrap; width: 90px; }
    .meal-cell { min-height: 56px; padding: 6px; border-radius: 4px; cursor: pointer; display: flex; flex-direction: column; justify-content: center; }
    .meal-cell.filled { background: var(--mud-palette-action-default-hover); }
    .meal-cell.empty { align-items: center; justify-content: center; opacity: 0.6; }
    .meal-cell.empty:hover { opacity: 1; }
</style>

@code {
    private static readonly string[] Slots = ["Breakfast", "Lunch", "Dinner"];

    private DateTime _weekStart;
    private MealPlanWeek? _week;
    private List<Recipe> _recipes = [];

    private IEnumerable<DateTime> Days => Enumerable.Range(0, 7).Select(i => _weekStart.AddDays(i));

    protected override async Task OnInitializedAsync()
    {
        UserContext.OnGroupChanged += OnGroupChanged;
        _weekStart = MealPlanService.GetWeekStart(DateTime.Now);
        if (UserContext.ActiveGroupId is not null)
            await LoadWeek(_weekStart);
    }

    private async void OnGroupChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadWeek(_weekStart);
            StateHasChanged();
        });
    }

    private async Task LoadWeek(DateTime weekStart)
    {
        if (UserContext.ActiveGroupId is not int groupId) return;

        _weekStart = weekStart;
        _week = await MealPlanSvc.GetOrCreateWeekAsync(groupId, weekStart);
        _recipes = await RecipeSvc.GetRecipesAsync(groupId);
    }

    private async Task GoToWeek(int dayOffset) => await LoadWeek(_weekStart.AddDays(dayOffset));

    private MealPlanEntry? GetEntry(DateTime date, string slot) =>
        _week?.Entries.FirstOrDefault(e => e.Date == date.Date && e.MealSlot == slot);

    private async Task OpenPicker(DateTime date, string slot, MealPlanEntry? existing)
    {
        if (_recipes.Count == 0 || _week is null || UserContext.ActiveGroupId is not int groupId) return;

        var recent = await MealPlanSvc.GetRecentlyUsedRecipesAsync(groupId, _week.Id);

        var parameters = new DialogParameters<MealPlanEntryDialog>
        {
            { x => x.Date, date },
            { x => x.MealSlot, slot },
            { x => x.AllRecipes, _recipes },
            { x => x.RecentRecipes, recent },
            { x => x.ExistingRecipe, existing?.Recipe },
            { x => x.ExistingServings, existing?.PlannedServings ?? 0 }
        };
        var dialog = await DialogService.ShowAsync<MealPlanEntryDialog>($"{slot} · {date:MMM d}", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not MealPlanEntryDialog.EntryResult data) return;

        if (data.Remove && existing is not null)
        {
            await MealPlanSvc.UnassignAsync(existing.Id);
        }
        else if (data.RecipeId is int recipeId)
        {
            await MealPlanSvc.AssignRecipeAsync(_week.Id, date, slot, recipeId, data.PlannedServings);
        }

        await LoadWeek(_weekStart);
    }

    public void Dispose()
    {
        UserContext.OnGroupChanged -= OnGroupChanged;
    }
}
