@inherits LayoutComponentBase
@using BBF.Mobile.Push
@using BBF.Shared.Contracts.Devices
@inject BBF.Shared.ApiGroupContext ApiGroupContext
@inject IPushTokenProvider PushTokenProvider
@inject IDeviceService DeviceService
@inject BBF.Mobile.Auth.MobileAuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@implements IDisposable

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h5">BBF</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                @if (ApiGroupContext.Groups.Count > 1)
                {
                    <MudSelect T="int?" Value="ApiGroupContext.ActiveGroupId"
                               ValueChanged="OnGroupChanged"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Style="max-width: 140px; color: inherit;">
                        @foreach (var group in ApiGroupContext.Groups)
                        {
                            <MudSelectItem T="int?" Value="@group.Id">@group.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.Bottom" Breakpoint="Breakpoint.Md" Elevation="2"
               Variant="@DrawerVariant.Temporary" Height="80%">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="px-2 px-sm-4">
        <AuthorizeView>
            <Authorized>
                @if (ApiGroupContext.IsInitialized)
                {
                    @Body
                }
                else if (_groupLoadFailed)
                {
                    @* Without this, every page shows "No Budget Group" when the load simply failed. *@
                    <MudPaper Class="pa-6 mt-4 text-center" Elevation="2">
                        <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                        <MudText Typo="Typo.h6" Class="mb-2">Couldn't reach BBF</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            Your group data didn't load. Check your connection and try again.
                        </MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadGroupsAsync"
                                   Disabled="_loadingGroups" StartIcon="@Icons.Material.Filled.Refresh">
                            Try again
                        </MudButton>
                    </MudPaper>
                }
                else
                {
                    <div class="d-flex justify-center mt-8">
                        <MudProgressCircular Indeterminate Color="Color.Primary" />
                    </div>
                }
            </Authorized>
            <NotAuthorized>
                @Body
            </NotAuthorized>
        </AuthorizeView>
    </MudMainContent>

    <BottomNav OnMore="ToggleDrawer" />
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">X</span>
</div>

@code {
    private bool _drawerOpen;
    private bool _loadingGroups;
    private bool _groupLoadFailed;
    private Microsoft.Maui.Controls.Window? _window;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // "/" has no [Authorize] attribute (it shows its own Welcome/Sign-in screen for anonymous
        // visitors), so this layout renders before login too — never call an authenticated API
        // without checking first, or ApiAuthDelegatingHandler throws "Not signed in."
        if (firstRender && AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                await LoadGroupsAsync();
                _ = RegisterPushTokenAsync();
            }

            // Coming back to the app is the most common time a load has failed (phone was offline,
            // server was restarting), so retry then instead of waiting for an app restart.
            _window = Microsoft.Maui.Controls.Application.Current?.Windows.FirstOrDefault();
            if (_window is not null)
                _window.Resumed += OnWindowResumed;
        }
    }

    private async Task LoadGroupsAsync()
    {
        if (_loadingGroups || ApiGroupContext.IsInitialized) return;

        _loadingGroups = true;
        _groupLoadFailed = false;
        StateHasChanged();
        try
        {
            // A couple of quick retries cover brief network drops without bothering the user.
            for (var attempt = 1; ; attempt++)
            {
                try
                {
                    await ApiGroupContext.InitializeAsync();
                    break;
                }
                catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    // The saved sign-in was rejected (expired or revoked): sign in again rather than
                    // looking signed in with no data.
                    AuthProvider.SignOut();
                    Nav.NavigateTo("/login", replace: true);
                    return;
                }
                catch (Exception) when (attempt < 3)
                {
                    await Task.Delay(TimeSpan.FromSeconds(attempt * 2));
                }
            }
        }
        catch (Exception)
        {
            _groupLoadFailed = true;
        }
        finally
        {
            _loadingGroups = false;
            StateHasChanged();
        }
    }

    private void OnWindowResumed(object? sender, EventArgs e)
    {
        if (_groupLoadFailed)
            _ = InvokeAsync(LoadGroupsAsync);
    }

    public void Dispose()
    {
        if (_window is not null)
            _window.Resumed -= OnWindowResumed;
    }

    private async Task RegisterPushTokenAsync()
    {
        // Covers the "already signed in from a previous session" path (Login.razor's own call
        // after a fresh sign-in covers the other one); best-effort, same as token-refresh handling.
        try
        {
            var token = await PushTokenProvider.GetCurrentTokenAsync();
            if (!string.IsNullOrEmpty(token))
                await DeviceService.RegisterAsync(new RegisterDeviceRequest(token, "Android"));
        }
        catch
        {
        }
    }

    private void OnGroupChanged(int? groupId)
    {
        if (groupId.HasValue)
            ApiGroupContext.SetActiveGroup(groupId.Value);
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
