@inherits LayoutComponentBase
@using BBF.Mobile.Push
@using BBF.Shared.Contracts.Devices
@inject BBF.Shared.ApiGroupContext ApiGroupContext
@inject IPushTokenProvider PushTokenProvider
@inject IDeviceService DeviceService

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h5">BBF</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                @if (ApiGroupContext.Groups.Count > 1)
                {
                    <MudSelect T="int?" Value="ApiGroupContext.ActiveGroupId"
                               ValueChanged="OnGroupChanged"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Style="max-width: 140px; color: inherit;">
                        @foreach (var group in ApiGroupContext.Groups)
                        {
                            <MudSelectItem T="int?" Value="@group.Id">@group.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.Bottom" Breakpoint="Breakpoint.Md" Elevation="2"
               Variant="@DrawerVariant.Temporary" Height="80%">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="px-2 px-sm-4">
        @Body
    </MudMainContent>

    <BottomNav OnMore="ToggleDrawer" />
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">X</span>
</div>

@code {
    private bool _drawerOpen;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // "/" has no [Authorize] attribute (it shows its own Welcome/Sign-in screen for anonymous
        // visitors), so this layout renders before login too — never call an authenticated API
        // without checking first, or ApiAuthDelegatingHandler throws "Not signed in."
        if (firstRender && AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                await ApiGroupContext.InitializeAsync();
                StateHasChanged();

                _ = RegisterPushTokenAsync();
            }
        }
    }

    private async Task RegisterPushTokenAsync()
    {
        // Covers the "already signed in from a previous session" path (Login.razor's own call
        // after a fresh sign-in covers the other one); best-effort, same as token-refresh handling.
        try
        {
            var token = await PushTokenProvider.GetCurrentTokenAsync();
            if (!string.IsNullOrEmpty(token))
                await DeviceService.RegisterAsync(new RegisterDeviceRequest(token, "Android"));
        }
        catch
        {
        }
    }

    private void OnGroupChanged(int? groupId)
    {
        if (groupId.HasValue)
            ApiGroupContext.SetActiveGroup(groupId.Value);
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
