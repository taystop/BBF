@using BBF.Shared.Contracts.Auth
@using BBF.Shared.Contracts.Chat

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Share this conversation with your groups. Members of shared groups can view the conversation.
        </MudText>

        @foreach (var group in Groups)
        {
            var isShared = _sharedGroupIds.Contains(group.Id);
            <MudPaper Class="pa-3 mb-2" Elevation="1">
                <MudStack Row AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.Group" Color="Color.Primary" />
                    <MudText Typo="Typo.subtitle2">@group.Name</MudText>
                    <MudSpacer />
                    <MudSwitch T="bool" Value="isShared" ValueChanged="@(v => ToggleGroupShare(group.Id, v))"
                               Color="Color.Primary" />
                </MudStack>
            </MudPaper>
        }

        @if (Groups.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                You have no groups to share with. Create a group first.
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Close</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Inject] private IChatService ChatSvc { get; set; } = null!;

    [Parameter] public List<GroupDto> Groups { get; set; } = [];
    [Parameter] public List<int> CurrentGroupIds { get; set; } = [];
    [Parameter] public int ConversationId { get; set; }

    private HashSet<int> _sharedGroupIds = [];

    protected override void OnInitialized()
    {
        _sharedGroupIds = CurrentGroupIds.ToHashSet();
    }

    private void ToggleGroupShare(int groupId, bool share)
    {
        if (share)
            _sharedGroupIds.Add(groupId);
        else
            _sharedGroupIds.Remove(groupId);
    }

    private async Task Save()
    {
        await ChatSvc.UpdateSharesAsync(ConversationId, new UpdateChatSharesRequest(_sharedGroupIds.ToList()));
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
