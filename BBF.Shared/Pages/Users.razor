@page "/users"
@using BBF.Shared.Contracts.Users
@attribute [Authorize(Roles = "Admin")]
@inject IUserManagementService UserMgmt
@inject IDialogService DialogService

<PageTitle>Users - BBF</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    <MudStack Row AlignItems="AlignItems.Center" Style="flex-wrap: wrap; gap: 8px;" Class="mb-4">
        <MudText Typo="Typo.h4">User Management</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_searchText" Placeholder="Search users..."
                      Variant="Variant.Outlined" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Immediate
                      Margin="Margin.Dense" Style="max-width: 300px; min-width: 150px;" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenCreateDialog">
            Add User
        </MudButton>
    </MudStack>

    @* Role management *@
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Style="flex-wrap: wrap; gap: 8px;">
            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Secondary" />
            <MudText Typo="Typo.subtitle1">Roles</MudText>
            <MudSpacer />
            @foreach (var role in _roles)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                         OnClose="@(() => DeleteRole(role))">@role</MudChip>
            }
            <MudTextField @bind-Value="_newRoleName" Placeholder="New role..."
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Style="max-width: 180px; min-width: 120px;"
                          Immediate />
            <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary"
                           OnClick="AddRole"
                           Disabled="@(string.IsNullOrWhiteSpace(_newRoleName))" />
        </MudStack>
    </MudPaper>

    @* Users table *@
    <div style="overflow-x: auto;">
    <MudTable Items="FilteredUsers" Hover Elevation="2" Loading="_loading">
        <HeaderContent>
            <MudTh>Email</MudTh>
            <MudTh>Email Confirmed</MudTh>
            <MudTh>Roles</MudTh>
            <MudTh>Lockout</MudTh>
            <MudTh Style="width: 120px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Email">
                <MudText Typo="Typo.body2">@context.Email</MudText>
            </MudTd>
            <MudTd DataLabel="Email Confirmed">
                @if (context.EmailConfirmed)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" />
                }
            </MudTd>
            <MudTd DataLabel="Roles">
                @if (context.Roles.Any())
                {
                    @foreach (var role in context.Roles)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                 Variant="Variant.Outlined" Class="mr-1">@role</MudChip>
                    }
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">None</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Lockout">
                @if (context.IsLockedOut)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Locked</MudChip>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Active</MudText>
                }
            </MudTd>
            <MudTd>
                <MudStack Row Spacing="0">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => OpenEditDialog(context))" title="Edit user" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(() => DeleteUser(context))" title="Delete user" />
                </MudStack>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                @(string.IsNullOrWhiteSpace(_searchText) ? "No users found." : "No matching users.")
            </MudText>
        </NoRecordsContent>
    </MudTable>
    </div>
</MudContainer>

@code {
    private List<UserSummaryDto> _users = [];
    private List<string> _roles = [];
    private string _searchText = string.Empty;
    private string _newRoleName = string.Empty;
    private bool _loading;

    private IEnumerable<UserSummaryDto> FilteredUsers =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _users
            : _users.Where(u =>
                (u.Email?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) == true) ||
                u.Roles.Any(r => r.Contains(_searchText, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        StateHasChanged();

        _roles = await UserMgmt.GetAllRolesAsync();
        _users = await UserMgmt.GetAllUsersAsync();

        _loading = false;
        StateHasChanged();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<UserDialog>
        {
            { x => x.IsNew, true },
            { x => x.AllRoles, _roles.ToList() },
            { x => x.SelectedRoles, new List<string>() }
        };
        var dialog = await DialogService.ShowAsync<UserDialog>("Create User", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is UserDialog.UserDialogResult data)
        {
            try
            {
                await UserMgmt.CreateUserAsync(new CreateUserRequest(data.Email, data.Password ?? "", data.Roles));
                await LoadData();
            }
            catch (Exception ex)
            {
                await ShowError(ex.Message);
            }
        }
    }

    private async Task OpenEditDialog(UserSummaryDto row)
    {
        var parameters = new DialogParameters<UserDialog>
        {
            { x => x.IsNew, false },
            { x => x.UserId, row.Id },
            { x => x.Email, row.Email ?? string.Empty },
            { x => x.AllRoles, _roles.ToList() },
            { x => x.SelectedRoles, row.Roles.ToList() }
        };
        var dialog = await DialogService.ShowAsync<UserDialog>("Edit User", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is UserDialog.UserDialogResult data)
        {
            try
            {
                await UserMgmt.UpdateUserAsync(row.Id, new UpdateUserRequest(data.Email, data.Password, data.Roles));
                await LoadData();
            }
            catch (Exception ex)
            {
                await ShowError(ex.Message);
            }
        }
    }

    private async Task DeleteUser(UserSummaryDto row)
    {
        var parameters = new DialogParameters<MessageBoxDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete '{row.Email}'? This cannot be undone." },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };
        var dialog = await DialogService.ShowAsync<MessageBoxDialog>("Delete User", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await UserMgmt.DeleteUserAsync(row.Id);
            await LoadData();
        }
    }

    private async Task AddRole()
    {
        var name = _newRoleName.Trim();
        if (string.IsNullOrEmpty(name)) return;

        await UserMgmt.CreateRoleAsync(name);
        _newRoleName = string.Empty;
        await LoadData();
    }

    private async Task DeleteRole(string roleName)
    {
        var parameters = new DialogParameters<MessageBoxDialog>
        {
            { x => x.ContentText, $"Delete role '{roleName}'? Users in this role will lose it." },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };
        var dialog = await DialogService.ShowAsync<MessageBoxDialog>("Delete Role", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await UserMgmt.DeleteRoleAsync(roleName);
            await LoadData();
        }
    }

    private async Task ShowError(string message)
    {
        await DialogService.ShowAsync<MessageBoxDialog>("Error", new DialogParameters<MessageBoxDialog>
        {
            { x => x.ContentText, message },
            { x => x.ButtonText, "OK" }
        });
    }
}
