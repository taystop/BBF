@using BBF.Shared.Contracts.Accounts

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? "Add Goal" : "Edit Goal")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="Name" Label="Name" Required
                      Variant="Variant.Outlined" Class="mb-3" />
        <MudNumericField @bind-Value="TargetAmount" Label="Target Amount ($)" Required
                         Variant="Variant.Outlined" Class="mb-3" Min="0" Format="N2" />
        <MudDatePicker @bind-Date="TargetDate" Label="Target Date (optional)"
                       Variant="Variant.Outlined" Class="mb-3" Clearable />
        @if (Accounts.Count > 0)
        {
            <MudSelect T="int?" @bind-Value="AccountId" Label="Account (optional)"
                       Variant="Variant.Outlined" Class="mb-3" Clearable>
                @foreach (var acct in Accounts)
                {
                    <MudSelectItem T="int?" Value="@acct.Id">@acct.Name</MudSelectItem>
                }
            </MudSelect>
        }
        <MudSwitch @bind-Value="IsActive" Label="Active" Color="Color.Primary" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@(string.IsNullOrWhiteSpace(Name) || TargetAmount <= 0)">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool IsNew { get; set; } = true;
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public decimal TargetAmount { get; set; }
    [Parameter] public DateTime? TargetDate { get; set; }
    [Parameter] public int? AccountId { get; set; }
    [Parameter] public bool IsActive { get; set; } = true;
    [Parameter] public List<AccountDto> Accounts { get; set; } = [];

    private void Cancel() => MudDialog.Cancel();
    private void Submit() => MudDialog.Close(DialogResult.Ok(new GoalResult
    {
        Name = Name,
        TargetAmount = TargetAmount,
        TargetDate = TargetDate,
        AccountId = AccountId,
        IsActive = IsActive
    }));

    public class GoalResult
    {
        public string Name { get; set; } = string.Empty;
        public decimal TargetAmount { get; set; }
        public DateTime? TargetDate { get; set; }
        public int? AccountId { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
