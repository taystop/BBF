@page "/recurring"
@using BBF.Shared.Contracts.Accounts
@using BBF.Shared.Contracts.Budget
@using BBF.Shared.Contracts.Recurring
@using BBF.Shared.Contracts.Bills
@using BBF.Shared.Contracts.Money
@attribute [Authorize]
@inject IMoneyService MoneySvc
@inject IRecurringTransactionService RecurringSvc
@inject IBillService BillSvc
@inject IAccountService AccountSvc
@inject IBudgetCategoryService CategorySvc
@inject ApiGroupContext GroupContext
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Recurring - BBF</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    @if (!GroupContext.IsInitialized || GroupContext.ActiveGroupId is null)
    {
        <MudPaper Class="pa-6 text-center" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
            <MudText Typo="Typo.h5" Class="mb-2">No Budget Group</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                Create or join a group to start tracking your budget. Groups let you share budget data with family members.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/groups"
                       StartIcon="@Icons.Material.Filled.GroupAdd">
                Manage Groups
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudStack Row AlignItems="AlignItems.Center" Style="flex-wrap: wrap; gap: 8px;" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Autorenew" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h4">Recurring Transactions</MudText>
        </MudStack>


        @if (_suggestions.Count > 0)
        {
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-1">Suggested bills</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                    These showed up on a steady schedule in your recent transactions. Add one to track it as a bill.
                </MudText>
                @foreach (var sug in _suggestions)
                {
                    <MudPaper Class="pa-3 mb-2" Elevation="1" @key="sug.Key">
                        <div class="d-flex align-center flex-wrap" style="gap: 8px 12px;">
                            <MudStack Spacing="0" Style="flex: 1; min-width: 160px;">
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@sug.Payee</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @SuggestionScheduleText(sug) · seen @string.Join(", ", sug.Dates.Select(d => d.ToString("MMM d")))
                                </MudText>
                            </MudStack>
                            <MudText Typo="Typo.body2" Style="min-width: 80px; text-align: right;">@sug.Amount.ToString("C")</MudText>
                            <div class="d-flex" style="gap: 4px;">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AcceptSuggestion(sug))">Add</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => DismissSuggestion(sug))">Not recurring</MudButton>
                            </div>
                        </div>
                    </MudPaper>
                }
            </MudPaper>
        }

        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudStack Row AlignItems="AlignItems.Center" Style="flex-wrap: wrap; gap: 8px;" Class="mb-1">
                <MudText Typo="Typo.h6">Bills</MudText>
                <MudSpacer />
                <MudChipSet T="string" @bind-SelectedValue="_billFilter" SelectionMode="SelectionMode.SingleSelection" CheckMark="false">
                    <MudChip T="string" Value="@("upcoming")" Size="Size.Small">Upcoming</MudChip>
                    <MudChip T="string" Value="@("recent")" Size="Size.Small">Recent</MudChip>
                </MudChipSet>
            </MudStack>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                Each bill is marked paid automatically when a matching bank transaction arrives.
            </MudText>

            @foreach (var bill in VisibleBills)
            {
                var status = BillStatusLabel(bill);
                <MudPaper Class="pa-3 mb-2" Elevation="1">
                    <div class="d-flex align-center flex-wrap" style="gap: 8px 12px;">
                        <MudStack Spacing="0" Style="min-width: 64px;">
                            <MudText Typo="Typo.subtitle2">@bill.DueDate.ToString("MMM d")</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@bill.DueDate.ToString("ddd")</MudText>
                        </MudStack>
                        <MudStack Spacing="0" Style="flex: 1; min-width: 140px;">
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@bill.Payee</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(bill.TransactionId is not null
                                    ? $"Paid by \"{bill.TransactionDescription}\" {bill.TransactionAmount:C} on {bill.TransactionDate:MMM d}"
                                    : bill.CategoryName ?? bill.AccountName)
                            </MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2" Style="min-width: 80px; text-align: right;">@bill.ExpectedAmount.ToString("C")</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@status.Color">@status.Text</MudChip>
                        <div class="d-flex">
                            @if (bill.Status == "Expected")
                            {
                                <MudTooltip Text="Mark paid">
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                                                   OnClick="@(() => SetBillStatus(bill, "Paid"))" />
                                </MudTooltip>
                                <MudTooltip Text="Skip this one">
                                    <MudIconButton Icon="@Icons.Material.Filled.SkipNext" Size="Size.Small"
                                                   OnClick="@(() => SetBillStatus(bill, "Skipped"))" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="Undo (back to expected)">
                                    <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small"
                                                   OnClick="@(() => SetBillStatus(bill, "Expected"))" />
                                </MudTooltip>
                            }
                        </div>
                    </div>
                </MudPaper>
            }

            @if (!VisibleBills.Any())
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
                    @(_billFilter == "upcoming" ? "No bills due in the next 45 days." : "No bills in the last 30 days.")
                </MudText>
            }
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Row AlignItems="AlignItems.Center" Style="flex-wrap: wrap; gap: 8px;" Class="mb-3">
                <MudText Typo="Typo.h6">Rules</MudText>
                <MudSpacer />
                @if (_accounts.Count == 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Add an account first to create a rule.</MudText>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AddRule"
                           Disabled="@(_accounts.Count == 0)">
                    Add Rule
                </MudButton>
            </MudStack>

            <div class="budget-table-container">
                <MudTable Items="_rules" Hover Dense Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>Payee</MudTh>
                        <MudTh Style="text-align: right;">Amount</MudTh>
                        <MudTh>Category</MudTh>
                        <MudTh>Account</MudTh>
                        <MudTh>Frequency</MudTh>
                        <MudTh>Next</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh Style="width: 100px;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Payee">@context.Payee</MudTd>
                        <MudTd DataLabel="Amount" Style="text-align: right;">
                            <MudText Typo="Typo.body2" Color="@(context.Amount >= 0 ? Color.Error : Color.Success)">
                                @context.Amount.ToString("C")
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="Category">@(context.CategoryName ?? "—")</MudTd>
                        <MudTd DataLabel="Account">@context.AccountName</MudTd>
                        <MudTd DataLabel="Frequency">
                            @context.Frequency
                            @if (context.AutoPost)
                            {
                                <MudTooltip Text="Posted automatically on each due date">
                                    <MudIcon Icon="@Icons.Material.Filled.FlashOn" Size="Size.Small" Class="ml-1" />
                                </MudTooltip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Next">@((context.NextDue ?? context.NextOccurrence).ToString("MMM d, yyyy"))</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                                @(context.IsActive ? "Active" : "Inactive")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Actions">
                            <MudStack Row Spacing="0">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               OnClick="@(() => EditRule(context))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => DeleteRule(context))" />
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                            No recurring transactions yet.
                        </MudText>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </MudPaper>
    }
</MudContainer>

<style>
    .budget-table-container {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
</style>

@code {
    private List<RecurringTransactionDto> _rules = [];
    private List<BudgetCategoryDto> _categories = [];
    private List<AccountDto> _accounts = [];
    private List<BillOccurrenceDto> _bills = [];
    private List<RecurringSuggestionDto> _suggestions = [];
    private string _billFilter = "upcoming";

    private IEnumerable<BillOccurrenceDto> VisibleBills => _billFilter == "upcoming"
        ? _bills.Where(b => b.DueDate >= DateTime.Today || b.Status == "Expected")
        : _bills.Where(b => b.DueDate < DateTime.Today).Reverse();

    private static (string Text, Color Color) BillStatusLabel(BillOccurrenceDto bill) => bill.Status switch
    {
        "Paid" => ("Paid", Color.Success),
        "Skipped" => ("Skipped", Color.Default),
        _ when bill.DueDate < DateTime.Today => ("Overdue", Color.Error),
        _ when bill.DueDate <= DateTime.Today.AddDays(3) => ("Due soon", Color.Warning),
        _ => ("Expected", Color.Info),
    };

    private async Task SetBillStatus(BillOccurrenceDto bill, string status)
    {
        await BillSvc.UpdateStatusAsync(GroupContext.ActiveGroupId!.Value, bill.Id, new UpdateBillStatusRequest(status));
        await LoadData();
    }

    protected override async Task OnInitializedAsync()
    {
        GroupContext.OnGroupChanged += OnGroupChanged;
        if (GroupContext.ActiveGroupId is not null)
            await LoadData();
    }

    private async void OnGroupChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    private async Task LoadData()
    {
        var groupId = GroupContext.ActiveGroupId;
        if (groupId is null) return;

        _rules = await RecurringSvc.GetActiveAsync(groupId.Value);
        _accounts = (await AccountSvc.GetAccountsAsync(groupId.Value)).Where(a => !a.IsHidden).ToList();
        _categories = await CategorySvc.GetCategoriesAsync(groupId.Value);
        _bills = await BillSvc.GetBillsAsync(groupId.Value, DateTime.Today.AddDays(-30), DateTime.Today.AddDays(45));
        await LoadSuggestions(groupId.Value, income: false);

        StateHasChanged();
    }

    private async Task AddRule()
    {
        var parameters = new DialogParameters<RecurringTransactionDialog>
        {
            { x => x.IsNew, true },
            { x => x.Categories, _categories },
            { x => x.Accounts, _accounts },
            { x => x.AccountId, _accounts[0].Id }
        };
        var dialog = await DialogService.ShowAsync<RecurringTransactionDialog>("Add Recurring Transaction", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is RecurringTransactionDialog.RecurringTransactionResult data)
        {
            await RecurringSvc.CreateAsync(GroupContext.ActiveGroupId!.Value, new CreateRecurringTransactionRequest(
                data.Payee, data.Amount, data.CategoryId, data.AccountId, data.Frequency, data.NextOccurrence, data.EndDate,
                data.AutoPost, data.MatchText));
            Snackbar.Add("Recurring rule created.", Severity.Success);
            await LoadData();
        }
    }

    private async Task EditRule(RecurringTransactionDto rule)
    {
        var parameters = new DialogParameters<RecurringTransactionDialog>
        {
            { x => x.IsNew, false },
            { x => x.Payee, rule.Payee },
            { x => x.Amount, rule.Amount },
            { x => x.CategoryId, rule.CategoryId },
            { x => x.Categories, _categories },
            { x => x.AccountId, rule.AccountId },
            { x => x.Accounts, _accounts },
            { x => x.Frequency, rule.Frequency },
            // The next bill still due, not the rule's internal pointer (which runs ~60 days ahead).
            { x => x.NextOccurrence, rule.NextDue ?? rule.NextOccurrence },
            { x => x.AutoPost, rule.AutoPost },
            { x => x.MatchText, rule.MatchText },
            { x => x.EndDate, rule.EndDate },
            { x => x.IsActive, rule.IsActive }
        };
        var dialog = await DialogService.ShowAsync<RecurringTransactionDialog>("Edit Recurring Transaction", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is RecurringTransactionDialog.RecurringTransactionResult data)
        {
            await RecurringSvc.UpdateAsync(GroupContext.ActiveGroupId!.Value, rule.Id, new UpdateRecurringTransactionRequest(
                data.Payee, data.Amount, data.CategoryId, data.AccountId, data.Frequency, data.NextOccurrence, data.EndDate, data.IsActive,
                data.AutoPost, data.MatchText));
            await LoadData();
        }
    }

    private async Task DeleteRule(RecurringTransactionDto rule)
    {
        var parameters = new DialogParameters<MessageBoxDialog>
        {
            { x => x.ContentText, $"Delete recurring rule for '{rule.Payee}'? Already-created transactions are kept." },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };
        var dialog = await DialogService.ShowAsync<MessageBoxDialog>("Delete Recurring Transaction", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await RecurringSvc.DeleteAsync(GroupContext.ActiveGroupId!.Value, rule.Id);
            await LoadData();
        }
    }

    private static string SuggestionScheduleText(RecurringSuggestionDto sug) => sug.Frequency switch
    {
        "Weekly" => $"every week, next {sug.NextDue:ddd MMM d}",
        "BiWeekly" => $"every two weeks, next {sug.NextDue:ddd MMM d}",
        _ => $"monthly around the {Ordinal(sug.NextDue.Day)}",
    };

    private static string Ordinal(int day) => day + (day % 100 is 11 or 12 or 13 ? "th" : (day % 10) switch { 1 => "st", 2 => "nd", 3 => "rd", _ => "th" });

    private async Task DismissSuggestion(RecurringSuggestionDto sug)
    {
        try
        {
            await MoneySvc.DismissSuggestionAsync(GroupContext.ActiveGroupId!.Value, new DismissSuggestionRequest(sug.Key));
            _suggestions.Remove(sug);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't dismiss it: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadSuggestions(int groupId, bool income)
    {
        try
        {
            _suggestions = (await MoneySvc.GetSuggestionsAsync(groupId)).Where(s => s.IsIncome == income).ToList();
        }
        catch (Exception)
        {
            _suggestions = []; // suggestions are a nice-to-have; never block the page on them
        }
    }

    private async Task AcceptSuggestion(RecurringSuggestionDto sug)
    {
        if (_accounts.Count == 0)
        {
            Snackbar.Add("Add an account first.", Severity.Warning);
            return;
        }
        var parameters = new DialogParameters<RecurringTransactionDialog>
        {
            { x => x.IsNew, true },
            { x => x.Payee, sug.Payee },
            { x => x.MatchText, sug.MatchText },
            { x => x.Amount, sug.Amount },
            { x => x.CategoryId, sug.CategoryId },
            { x => x.Categories, _categories },
            { x => x.Accounts, _accounts },
            { x => x.AccountId, _accounts.Any(a => a.Id == sug.AccountId) ? sug.AccountId!.Value : _accounts[0].Id },
            { x => x.Frequency, sug.Frequency },
            { x => x.NextOccurrence, sug.NextDue },
        };
        var dialog = await DialogService.ShowAsync<RecurringTransactionDialog>("Add Recurring Transaction", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is RecurringTransactionDialog.RecurringTransactionResult data)
        {
            await RecurringSvc.CreateAsync(GroupContext.ActiveGroupId!.Value, new CreateRecurringTransactionRequest(
                data.Payee, data.Amount, data.CategoryId, data.AccountId, data.Frequency, data.NextOccurrence, data.EndDate,
                data.AutoPost, data.MatchText));
            Snackbar.Add($"{data.Payee} is now tracked as a bill.", Severity.Success);
            await LoadData();
        }
    }

    public void Dispose()
    {
        GroupContext.OnGroupChanged -= OnGroupChanged;
    }
}
