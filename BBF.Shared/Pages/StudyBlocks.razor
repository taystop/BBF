                        }
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">@_locationCorrect / @_locationTotal correct</MudChip>
                    }
                </div>

                @if (_locationStudyMode)
                {
                    <MudSimpleTable Dense Hover Bordered Striped>
                        <thead>
                            <tr>
                                <th>Location</th>
                                <th>Relative Location</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var loc in CommonLocations)
                            {
                                <tr>
                                    <td><b>@loc.Name</b></td>
                                    <td>@loc.RelativeLocation</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
                else if (_locationNoRepeat && _locationDeck.IsComplete)
                {
                    <MudAlert Severity="Severity.Success" Class="mb-3" Variant="Variant.Filled">
                        Round complete! @_locationDeck.History.Count(h => h.WasCorrect) of @_locationDeck.History.Count correct
                    </MudAlert>
                    @if (_locationDeck.History.Any(h => !h.WasCorrect))
                    {
                        <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Error">Missed Questions:</MudText>
                        @foreach (var m in _locationDeck.History.Where(h => !h.WasCorrect))
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-1" Dense="true">
                                @m.Question — <b>@m.Answer</b>
                            </MudAlert>
                        }
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Success" Class="mb-2">Perfect score!</MudAlert>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2"
                               OnClick="@(() => { _locationDeck.Reset(); _locationCorrect = 0; _locationTotal = 0; GenerateLocationQuestion(); })"
                               StartIcon="@Icons.Material.Filled.Refresh">New Round</MudButton>
                }
                else if (_locationQuestion != null)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3" NoIcon>
                        <MudText Typo="Typo.h6">@_locationQuestion.Prompt</MudText>
                    </MudAlert>

                    <div class="d-flex align-center gap-2 mb-3">
                        <MudTextField @ref="_locationInput" @bind-Value="_locationUserAnswer" T="string" Label="Your Answer"
                                      Variant="Variant.Outlined" Immediate OnKeyDown="OnLocationKeyDown"
                                      Disabled="_locationAnswered" Style="max-width:500px" />
                        @if (!_locationAnswered)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CheckLocationAnswer"
                                       StartIcon="@Icons.Material.Filled.Check">Check</MudButton>
                        }
                        else
                        {
                            <MudButton @ref="_locationNextBtn" Variant="Variant.Filled" Color="Color.Primary" OnClick="NextLocationQuestion"
                                       StartIcon="@Icons.Material.Filled.ArrowForward">Next</MudButton>
                        }
                    </div>

                    @if (_locationAnswered)
                    {
                        <MudAlert Severity="@(_locationWasCorrect ? Severity.Success : Severity.Error)" Class="mb-2">
                            @if (_locationWasCorrect) { <span>Correct!</span> }
                            else { <span>Incorrect. The answer is: <b>@_locationQuestion.Answer</b></span> }
                        </MudAlert>
                    }
                }
            </MudPaper>
        </MudTabPanel>

        @* amamamamam CALL TYPE TEST TAB amamamamam *@
        <MudTabPanel Text="Call Type Test" Icon="@Icons.Material.Filled.Phone">
            <MudPaper Class="pa-4">
                <div class="d-flex align-center gap-2 mb-3">
                    <MudSwitch Value="_codeTestNoRepeat" ValueChanged="OnCodeTestNoRepeatChanged" Label="No Repeat" Color="Color.Secondary" T="bool" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="ResetCodeTestScore" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Refresh">Reset Score</MudButton>
                    <MudSpacer />
                    @if (_codeTestNoRepeat && _codeTestDeck.PoolSize > 0 && !_codeTestDeck.IsComplete)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@(_codeTestDeck.History.Count + 1) of @_codeTestDeck.PoolSize</MudChip>
                    }
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@_codeTestCorrect / @_codeTestTotal correct</MudChip>
                </div>

                @if (_codeTestNoRepeat && _codeTestDeck.IsComplete)
                {
                    <MudAlert Severity="Severity.Success" Class="mb-3" Variant="Variant.Filled">
                        Round complete! @_codeTestDeck.History.Count(h => h.WasCorrect) of @_codeTestDeck.History.Count correct
                    </MudAlert>
                    @if (_codeTestDeck.History.Any(h => !h.WasCorrect))
                    {
                        <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Error">Missed Questions:</MudText>
                        @foreach (var m in _codeTestDeck.History.Where(h => !h.WasCorrect))
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-1" Dense="true">
                                @m.Question — <b>@m.Answer</b>
                            </MudAlert>
                        }
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Success" Class="mb-2">Perfect score!</MudAlert>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2"
                               OnClick="@(() => { _codeTestDeck.Reset(); _codeTestCorrect = 0; _codeTestTotal = 0; GenerateCodeTestQuestion(); })"
                               StartIcon="@Icons.Material.Filled.Refresh">New Round</MudButton>
                }
                else if (_currentCallGuide != null)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3" NoIcon>
                        <MudText Typo="Typo.h6">@_currentCallGuide.Scenario</MudText>
                    </MudAlert>

                    <MudGrid>
                        <MudItem xs="12" sm="5">
                            <MudTextField @ref="_codeTestInput" @bind-Value="_ctCallType" T="string" Label="Call Type"
                                          Variant="Variant.Outlined" Immediate OnKeyDown="OnCodeTestKeyDown"
                                          Disabled="_codeTestAnswered" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption" Class="mb-1">Agencies</MudText>
                            <div class="d-flex gap-4">
                                <MudCheckBox @bind-Value="_ctAgencyP" Label="P" Color="Color.Primary" T="bool" Disabled="_codeTestAnswered" />
                                <MudCheckBox @bind-Value="_ctAgencyF" Label="F" Color="Color.Error" T="bool" Disabled="_codeTestAnswered" />
                                <MudCheckBox @bind-Value="_ctAgencyE" Label="E" Color="Color.Warning" T="bool" Disabled="_codeTestAnswered" />
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudTextField @bind-Value="_ctPriority" T="string" Label="LE Priority"
                                          Variant="Variant.Outlined" Immediate OnKeyDown="OnCodeTestKeyDown"
                                          Disabled="_codeTestAnswered" />
                        </MudItem>
                    </MudGrid>

                    <div class="d-flex align-center gap-2 mt-3 mb-3">
                        @if (!_codeTestAnswered)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CheckCodeTestAnswer"
                                       StartIcon="@Icons.Material.Filled.Check">Check</MudButton>
                        }
                        else
                        {
                            <MudButton @ref="_codeTestNextBtn" Variant="Variant.Filled" Color="Color.Primary" OnClick="NextCodeTestQuestion"
                                       StartIcon="@Icons.Material.Filled.ArrowForward">Next</MudButton>
                        }
                    </div>

                    @if (_codeTestAnswered)
                    {
                        <MudGrid>
                            <MudItem xs="12" sm="4">
                                @if (_ctCallTypeCorrect)
                                {
                                    <MudAlert Severity="Severity.Success" Dense>Call Type: Correct!</MudAlert>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Error" Dense>
                                        Call Type: <b>@_currentCallGuide.CallType</b>
                                        @if (_currentCallGuide.AcceptableCallTypes.Count > 1)
                                        {
                                            <span class="ml-1">(also: @string.Join(", ", _currentCallGuide.AcceptableCallTypes.Skip(1)))</span>
                                        }
                                    </MudAlert>
                                }
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                @if (_ctAgenciesCorrect)
                                {
                                    <MudAlert Severity="Severity.Success" Dense>Agencies: Correct!</MudAlert>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Error" Dense>Agencies: <b>@_currentCallGuide.AgenciesDisplay</b></MudAlert>
                                }
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                @if (_ctPriorityCorrect)
                                {
                                    <MudAlert Severity="Severity.Success" Dense>Priority: Correct!</MudAlert>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Error" Dense>Priority: <b>@_currentCallGuide.PriorityDisplay</b></MudAlert>
                                }
                            </MudItem>
                        </MudGrid>

                        @if (_codeTestWasCorrect)
                        {
                            <MudAlert Severity="Severity.Success" Class="mt-2">All correct!</MudAlert>
                        }
                    }
                }
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    private int _activeTab;
    private bool _showOnTestOnly;
    private readonly Random _rng = new();

    // ===== ELEMENT REFERENCES FOR FOCUS MANAGEMENT =====
    private MudBlazor.MudTextField<string>? _matchInput, _neighborInput, _addrInput,
        _cityInput, _radioInput, _phoneticInput, _peopleInput, _locationInput, _codeTestInput;
    private MudBlazor.MudButton? _matchNextBtn, _neighborNextBtn, _addrNextBtn,
        _cityNextBtn, _radioNextBtn, _phoneticNextBtn, _peopleNextBtn, _locationNextBtn, _codeTestNextBtn;

    private enum FocusTarget { None, MatchNext, MatchInput, NeighborNext, NeighborInput,
        AddrNext, AddrInput, CityNext, CityInput, RadioNext, RadioInput,
        PhoneticNext, PhoneticInput, PeopleNext, PeopleInput, LocationNext, LocationInput,
        CodeTestNext, CodeTestInput }
    private FocusTarget _pendingFocus = FocusTarget.None;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var target = _pendingFocus;
        if (target == FocusTarget.None) return;
        _pendingFocus = FocusTarget.None;

        await Task.Delay(50);
        try
        {
            switch (target)
            {
                case FocusTarget.MatchNext:     if (_matchNextBtn is not null) await _matchNextBtn.FocusAsync(); break;
                case FocusTarget.MatchInput:     if (_matchInput is not null) await _matchInput.FocusAsync(); break;
                case FocusTarget.NeighborNext:   if (_neighborNextBtn is not null) await _neighborNextBtn.FocusAsync(); break;
                case FocusTarget.NeighborInput:  if (_neighborInput is not null) await _neighborInput.FocusAsync(); break;
                case FocusTarget.AddrNext:       if (_addrNextBtn is not null) await _addrNextBtn.FocusAsync(); break;
                case FocusTarget.AddrInput:      if (_addrInput is not null) await _addrInput.FocusAsync(); break;
                case FocusTarget.CityNext:       if (_cityNextBtn is not null) await _cityNextBtn.FocusAsync(); break;
                case FocusTarget.CityInput:      if (_cityInput is not null) await _cityInput.FocusAsync(); break;
                case FocusTarget.RadioNext:      if (_radioNextBtn is not null) await _radioNextBtn.FocusAsync(); break;
                case FocusTarget.RadioInput:     if (_radioInput is not null) await _radioInput.FocusAsync(); break;
                case FocusTarget.PhoneticNext:   if (_phoneticNextBtn is not null) await _phoneticNextBtn.FocusAsync(); break;
                case FocusTarget.PhoneticInput:  if (_phoneticInput is not null) await _phoneticInput.FocusAsync(); break;
                case FocusTarget.PeopleNext:     if (_peopleNextBtn is not null) await _peopleNextBtn.FocusAsync(); break;
                case FocusTarget.PeopleInput:    if (_peopleInput is not null) await _peopleInput.FocusAsync(); break;
                case FocusTarget.LocationNext:   if (_locationNextBtn is not null) await _locationNextBtn.FocusAsync(); break;
                case FocusTarget.LocationInput:  if (_locationInput is not null) await _locationInput.FocusAsync(); break;
                case FocusTarget.CodeTestNext:   if (_codeTestNextBtn is not null) await _codeTestNextBtn.FocusAsync(); break;
                case FocusTarget.CodeTestInput:  if (_codeTestInput is not null) await _codeTestInput.FocusAsync(); break;
            }
        }
        catch { /* element not yet in DOM, ignore */ }
    }

    // ===== MAP QUIZ DATA =====

    private bool _mapStudyMode = true;

    private int MapCorrectCount => _mapItems.Count(i => i.IsCorrect);
    private double MapProgress => _mapItems.Count > 0 ? (double)MapCorrectCount / _mapItems.Count * 100 : 0;
    private int MapCategoryCorrect(string cat) => _mapItems.Count(i => i.Category == cat && i.IsCorrect);
    private int MapCategoryTotal(string cat) => _mapItems.Count(i => i.Category == cat);

    private void OnMapValueChanged(MapItem item, string value)
    {
        item.UserAnswer = value;
        item.IsCorrect = CheckMapAnswer(item);
    }

    private bool CheckMapAnswer(MapItem item)
    {
        if (string.IsNullOrWhiteSpace(item.UserAnswer)) return false;
        var normalized = NormalizeMap(item.UserAnswer);
        return item.AcceptableNormalized.Contains(normalized);
    }

    private static string NormalizeMap(string s) =>
        s.Trim().ToLowerInvariant()
         .Replace("-", "").Replace(".", "").Replace(" ", "").Replace("'", "")
         .Replace("mount", "mt").Replace("saint", "st");

    private void ResetMap()
    {
        foreach (var item in _mapItems) { item.UserAnswer = ""; item.IsCorrect = false; }
    }

    private void RevealAllMap()
    {
        foreach (var item in _mapItems) { item.UserAnswer = item.CorrectAnswer; item.IsCorrect = true; }
    }

    private string GetMarkerFill(MapItem item)
    {
        if (item.IsCorrect) return "#2e7d32";
        if (!string.IsNullOrWhiteSpace(item.UserAnswer)) return "#e65100";
        return item.Category switch
        {
            "City" => "#1565c0", "Road" => "#5e548e", "County" => "#6d4c41", _ => "#757575"
        };
    }

    private string GetMapAdornmentIcon(MapItem item)
    {
        if (item.IsCorrect) return Icons.Material.Filled.CheckCircle;
        if (!string.IsNullOrWhiteSpace(item.UserAnswer)) return Icons.Material.Filled.Help;
        return Icons.Material.Filled.RadioButtonUnchecked;
    }

    private Color GetMapAdornmentColor(MapItem item)
    {
        if (item.IsCorrect) return Color.Success;
        if (!string.IsNullOrWhiteSpace(item.UserAnswer)) return Color.Warning;
        return Color.Default;
    }

    private string GetMapInputStyle(MapItem item) =>
        item.IsCorrect ? "background-color: rgba(46,125,50,0.08);" : "";

    private class MapItem
    {
        public required string Label { get; set; }
        public required string Category { get; set; }
        public required string CorrectAnswer { get; set; }
        public required double X { get; set; }
        public required double Y { get; set; }
        public string[] AcceptableAnswers { get; set; } = [];
        public HashSet<string> AcceptableNormalized { get; set; } = [];
        public string UserAnswer { get; set; } = "";
        public bool IsCorrect { get; set; }
    }

    private static MapItem MakeMapItem(string label, string category, string answer, double x, double y, params string[] alts)
    {
        var allAnswers = new[] { answer }.Concat(alts).ToArray();
        return new MapItem
        {
            Label = label, Category = category, CorrectAnswer = answer, X = x, Y = y,
            AcceptableAnswers = allAnswers,
            AcceptableNormalized = allAnswers.Select(NormalizeMap).ToHashSet()
        };
    }

