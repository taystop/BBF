    // ===== NORMALIZATION =====

    private static string Normalize(string s) =>
        s.Trim().ToLowerInvariant()
         .Replace("-", "").Replace(".", "").Replace("'", "").Replace("\"", "")
         .Replace("  ", " ")
         .Replace("road", "rd").Replace("street", "st")
         .Replace("mount ", "mt ").Replace("mount", "mt");

    private static bool AnswerMatches(string userAnswer, List<string> acceptable)
    {
        if (string.IsNullOrWhiteSpace(userAnswer)) return false;
        var norm = Normalize(userAnswer);
        return acceptable.Any(a => Normalize(a) == norm);
    }

    private static List<string> GetAcceptable(Street s)
    {
        var list = new List<string> { s.Display };
        if (s.AltName != null) list.Add(s.AltName);
        if (s.Display.Contains("th ") || s.Display.Contains("st ") || s.Display.Contains("nd ") || s.Display.Contains("rd "))
        {
            var numOnly = System.Text.RegularExpressions.Regex.Replace(s.Display, @"(st|nd|rd|th)\b", "");
            list.Add(numOnly);
        }
        if (s.AltName != null && (s.AltName.Contains("th ") || s.AltName.Contains("st ") || s.AltName.Contains("nd ") || s.AltName.Contains("rd ")))
        {
            var numOnly = System.Text.RegularExpressions.Regex.Replace(s.AltName, @"(st|nd|rd|th)\b", "");
            list.Add(numOnly);
        }
        return list;
    }

