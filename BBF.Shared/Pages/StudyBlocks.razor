    private bool _peopleAnswered, _peopleWasCorrect;
    private int _peopleCorrect, _peopleTotal;
    private bool _peopleNoRepeat;
    private readonly Deck _peopleDeck = new();

    private List<ImportantPerson> GetFilteredPeople() =>
        _peopleQuizOnTestOnly ? ImportantPeople.Where(p => p.OnTest).ToList() : ImportantPeople;

    private void GeneratePeopleQuestion()
    {
        var filtered = GetFilteredPeople();
        if (filtered.Count == 0) return;

        ImportantPerson entry;
        if (_peopleNoRepeat)
        {
            var idx = _peopleDeck.Pick(filtered.Count, _rng);
            if (idx == -1) { _peopleQuestion = null; return; }
            entry = filtered[idx];
        }
        else
        {
            entry = filtered[_rng.Next(filtered.Count)];
        }
        bool askForName = _rng.Next(2) == 0;

        if (askForName)
        {
            _peopleQuestion = new(
                $"Who holds the title: {entry.Title}?",
                entry.Name, null,
                new List<string> { entry.Name }
            );
        }
        else
        {
            _peopleQuestion = new(
                $"What is the title for {entry.Name}?",
                entry.Title, null,
                new List<string> { entry.Title }
            );
        }

        _peopleUserAnswer = "";
        _peopleAnswered = false;
        _peopleWasCorrect = false;
    }

    private async Task CheckPeopleAnswer()
    {
        if (_peopleQuestion == null) return;
        _peopleAnswered = true;
        _peopleTotal++;
        _peopleWasCorrect = AnswerMatches(_peopleUserAnswer, _peopleQuestion.Acceptable);
        if (_peopleWasCorrect) _peopleCorrect++;
        if (_peopleNoRepeat)
            _peopleDeck.Record(_peopleQuestion.Prompt, _peopleQuestion.Answer, _peopleWasCorrect);
        _pendingFocus = FocusTarget.PeopleNext;
    }

    private async Task NextPeopleQuestion()
    {
        GeneratePeopleQuestion();
        _pendingFocus = FocusTarget.PeopleInput;
    }

    private void ResetPeopleScore()
    {
        _peopleCorrect = 0;
        _peopleTotal = 0;
        _peopleDeck.Reset();
        GeneratePeopleQuestion();
    }

    private void OnPeopleNoRepeatChanged(bool value)
    {
        _peopleNoRepeat = value;
        _peopleDeck.Reset();
        _peopleCorrect = 0;
        _peopleTotal = 0;
        GeneratePeopleQuestion();
    }

    private async Task OnPeopleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (!_peopleAnswered) await CheckPeopleAnswer();
            else await NextPeopleQuestion();
        }
    }

