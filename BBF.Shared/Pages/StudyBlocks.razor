    private List<Street> GetPairedStreets(bool onTestOnly)
    {
        return EWStreets.Concat(NSStreets)
            .Where(s => s.AltName != null)
            .Where(s => !onTestOnly || s.OnTest)
            .ToList();
    }

    private void GenerateMatchQuestion()
    {
        var paired = GetPairedStreets(_matchOnTestOnly);
        if (paired.Count == 0) return;

        Street street;
        if (_matchNoRepeat)
        {
            var idx = _matchDeck.Pick(paired.Count, _rng);
            if (idx == -1) { _matchQuestion = null; return; }
            street = paired[idx];
        }
        else
        {
            street = paired[_rng.Next(paired.Count)];
        }
        bool askForAlt = _rng.Next(2) == 0;

        if (askForAlt)
        {
            _matchQuestion = new(
                $"What is the alternate name for {street.Display}?",
                street.AltName!, street.AltNote,
                new List<string> { street.AltName! }
            );
        }
        else
        {
            var displayWithNote = street.AltNote != null ? $"{street.AltName} {street.AltNote}" : street.AltName!;
            _matchQuestion = new(
                $"What is the hundred block / street name for {displayWithNote}?",
                street.Display, null,
                new List<string> { street.Display }
            );
        }

        _matchUserAnswer = "";
        _matchAnswered = false;
        _matchWasCorrect = false;
    }

    private async Task CheckMatchAnswer()
    {
        if (_matchQuestion == null) return;
        _matchAnswered = true;
        _matchTotal++;
        _matchWasCorrect = AnswerMatches(_matchUserAnswer, _matchQuestion.Acceptable);
        if (_matchWasCorrect) _matchCorrect++;
        if (_matchNoRepeat)
            _matchDeck.Record(_matchQuestion.Prompt, _matchQuestion.Answer, _matchWasCorrect);
        _pendingFocus = FocusTarget.MatchNext;
    }

    private async Task NextMatchQuestion()
    {
        GenerateMatchQuestion();
        _pendingFocus = FocusTarget.MatchInput;
    }

    private void ResetMatchScore()
    {
        _matchCorrect = 0;
        _matchTotal = 0;
        _matchDeck.Reset();
        GenerateMatchQuestion();
    }

    private void OnMatchNoRepeatChanged(bool value)
    {
        _matchNoRepeat = value;
        _matchDeck.Reset();
        _matchCorrect = 0;
        _matchTotal = 0;
        GenerateMatchQuestion();
    }

    private async Task OnMatchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (!_matchAnswered) await CheckMatchAnswer();
            else await NextMatchQuestion();
        }
    }

    // ===== NEIGHBOR QUIZ =====

    private record NeighborQ(string Prompt, bool HasBefore, string BeforeLabel, string BeforeAnswer,
                             List<string> BeforeAcceptable, bool HasAfter, string AfterLabel,
                             string AfterAnswer, List<string> AfterAcceptable);
    private NeighborQ? _neighborQuestion;
    private string _neighborAnswer1 = "", _neighborAnswer2 = "";
    private bool _neighborAnswered, _neighborWasCorrect;
    private int _neighborCorrect, _neighborTotal;
    private bool _neighborOnTestOnly = true;
    private bool _neighborNoRepeat;
    private readonly Deck _neighborDeck = new();

    private List<(bool IsEW, int OrigIdx)> GetNeighborPool()
    {
        var pool = new List<(bool IsEW, int OrigIdx)>();
        for (int i = 0; i < EWStreets.Count; i++)
            if (!_neighborOnTestOnly || EWStreets[i].OnTest) pool.Add((true, i));
        for (int i = 0; i < NSStreets.Count; i++)
            if (!_neighborOnTestOnly || NSStreets[i].OnTest) pool.Add((false, i));
        return pool;
    }

    private void GenerateNeighborQuestion()
    {
        var pool = GetNeighborPool();
        if (pool.Count == 0) return;

        (bool isEW, int idx) picked;
        if (_neighborNoRepeat)
        {
            var deckIdx = _neighborDeck.Pick(pool.Count, _rng);
            if (deckIdx == -1) { _neighborQuestion = null; return; }
            picked = pool[deckIdx];
        }
        else
        {
            picked = pool[_rng.Next(pool.Count)];
        }

        var list = picked.isEW ? EWStreets : NSStreets;
        var street = list[picked.idx];
        var idx = picked.idx;

        string dirBefore = picked.isEW ? "West" : "North";
        string dirAfter = picked.isEW ? "East" : "South";

        bool hasBefore = idx > 0;
        bool hasAfter = idx < list.Count - 1;

        var beforeStreet = hasBefore ? list[idx - 1] : null;
        var afterStreet = hasAfter ? list[idx + 1] : null;

        _neighborQuestion = new(
            $"What streets are immediately {dirBefore} and {dirAfter} of {street.Display}?",
            hasBefore, $"{dirBefore} of {street.Display}",
            hasBefore ? beforeStreet!.Display : "",
            hasBefore ? GetAcceptable(beforeStreet!) : [],
            hasAfter, $"{dirAfter} of {street.Display}",
            hasAfter ? afterStreet!.Display : "",
            hasAfter ? GetAcceptable(afterStreet!) : []
        );

        _neighborAnswer1 = "";
        _neighborAnswer2 = "";
        _neighborAnswered = false;
        _neighborWasCorrect = false;
    }

    private async Task CheckNeighborAnswer()
    {
        if (_neighborQuestion == null) return;
        _neighborAnswered = true;
        _neighborTotal++;

        bool beforeOk = !_neighborQuestion.HasBefore || AnswerMatches(_neighborAnswer1, _neighborQuestion.BeforeAcceptable);
        bool afterOk = !_neighborQuestion.HasAfter || AnswerMatches(_neighborAnswer2, _neighborQuestion.AfterAcceptable);
        _neighborWasCorrect = beforeOk && afterOk;
        if (_neighborWasCorrect) _neighborCorrect++;
        if (_neighborNoRepeat && _neighborQuestion != null)
        {
            var answer = (_neighborQuestion.HasBefore ? _neighborQuestion.BeforeAnswer : "") +
                         " / " +
                         (_neighborQuestion.HasAfter ? _neighborQuestion.AfterAnswer : "");
            _neighborDeck.Record(_neighborQuestion.Prompt, answer, _neighborWasCorrect);
        }
        _pendingFocus = FocusTarget.NeighborNext;
    }

    private async Task NextNeighborQuestion()
    {
        GenerateNeighborQuestion();
        _pendingFocus = FocusTarget.NeighborInput;
    }

    private void ResetNeighborScore()
    {
        _neighborCorrect = 0;
        _neighborTotal = 0;
        _neighborDeck.Reset();
        GenerateNeighborQuestion();
    }

    private void OnNeighborNoRepeatChanged(bool value)
    {
        _neighborNoRepeat = value;
        _neighborDeck.Reset();
        _neighborCorrect = 0;
        _neighborTotal = 0;
        GenerateNeighborQuestion();
    }

    // ===== ADDRESS QUIZ =====

    private record AddressQ(string Address, string CrossStreetAnswer, string? CrossStreetAlt,
                            List<string> CrossAcceptable, string CorrectSide);
    private AddressQ? _addrQuestion;
    private string _addrCrossStreet = "", _addrSide = "";
    private bool _addrAnswered, _addrCrossCorrect, _addrSideCorrect;
    private int _addrCorrect, _addrTotal;

    private void GenerateAddressQuestion()
    {
        bool baseIsEW = _rng.Next(2) == 0;

        var baseList = baseIsEW ? EWStreets : NSStreets;
        var crossList = baseIsEW ? NSStreets : EWStreets;

        var baseFiltered = baseList.Where(s => s.OnTest).ToList();
        var crossFiltered = crossList.Where(s => s.OnTest && s.BlockNumber > 0).ToList();

        if (baseFiltered.Count == 0 || crossFiltered.Count == 0)
        {
            _addrQuestion = null;
            return;
        }

        var baseStreet = baseFiltered[_rng.Next(baseFiltered.Count)];
        var crossStreet = crossFiltered[_rng.Next(crossFiltered.Count)];

        int block = crossStreet.BlockNumber;
        int lastTwo = _rng.Next(0, 100);
        int houseNumber = block * 100 + lastTwo;
        string direction = crossStreet.Direction;

        bool isEven = houseNumber % 2 == 0;
        string side;
        if (baseIsEW)
            side = isEven ? "East" : "West";
        else
            side = isEven ? "North" : "South";

        string address = $"{houseNumber} {direction} {baseStreet.Display}";

        _addrQuestion = new(address, crossStreet.Display, crossStreet.AltName, GetAcceptable(crossStreet), side);

        _addrCrossStreet = "";
        _addrSide = "";
        _addrAnswered = false;
        _addrCrossCorrect = false;
        _addrSideCorrect = false;
    }

    private async Task CheckAddressAnswer()
    {
        if (_addrQuestion == null) return;
        _addrAnswered = true;
        _addrTotal++;

        _addrCrossCorrect = AnswerMatches(_addrCrossStreet, _addrQuestion.CrossAcceptable);
        _addrSideCorrect = string.Equals(_addrSide, _addrQuestion.CorrectSide, StringComparison.OrdinalIgnoreCase);

        if (_addrCrossCorrect && _addrSideCorrect) _addrCorrect++;
        _pendingFocus = FocusTarget.AddrNext;
    }

    private async Task NextAddressQuestion()
    {
        GenerateAddressQuestion();
        _pendingFocus = FocusTarget.AddrInput;
    }

    private void ResetAddressScore()
    {
        _addrCorrect = 0;
        _addrTotal = 0;
        GenerateAddressQuestion();
    }

