    private void GenerateCodeTestQuestion()
    {
        if (_callGuides.Count == 0) return;

        CallGuide guide;
        if (_codeTestNoRepeat)
        {
            var idx = _codeTestDeck.Pick(_callGuides.Count, _rng);
            if (idx == -1) { _currentCallGuide = null; return; }
            guide = _callGuides[idx];
        }
        else
        {
            guide = _callGuides[_rng.Next(_callGuides.Count)];
        }

        _currentCallGuide = guide;
        _ctCallType = "";
        _ctAgencyP = false;
        _ctAgencyF = false;
        _ctAgencyE = false;
        _ctPriority = "";
        _codeTestAnswered = false;
        _codeTestWasCorrect = false;
        _ctCallTypeCorrect = false;
        _ctAgenciesCorrect = false;
        _ctPriorityCorrect = false;
    }

    private async Task CheckCodeTestAnswer()
    {
        if (_currentCallGuide == null) return;
        _codeTestAnswered = true;
        _codeTestTotal++;

        // Check call type
        var userType = Normalize(_ctCallType);
        _ctCallTypeCorrect = _currentCallGuide.AcceptableCallTypes.Any(a => Normalize(a) == userType);

        // Check agencies
        var userAgencies = "";
        if (_ctAgencyP) userAgencies += "P";
        if (_ctAgencyF) userAgencies += "F";
        if (_ctAgencyE) userAgencies += "E";
        _ctAgenciesCorrect = userAgencies == _currentCallGuide.Agencies;

        // Check priority (null means no LE priority — user should leave blank)
        if (_currentCallGuide.Priority == null)
            _ctPriorityCorrect = string.IsNullOrWhiteSpace(_ctPriority);
        else
            _ctPriorityCorrect = int.TryParse(_ctPriority.Trim(), out var p) && p == _currentCallGuide.Priority;

        _codeTestWasCorrect = _ctCallTypeCorrect && _ctAgenciesCorrect && _ctPriorityCorrect;
        if (_codeTestWasCorrect) _codeTestCorrect++;
        if (_codeTestNoRepeat)
        {
            var correctAnswer = $"{_currentCallGuide.CallType} | {_currentCallGuide.AgenciesDisplay} | Pri {_currentCallGuide.PriorityDisplay}";
            _codeTestDeck.Record(_currentCallGuide.Scenario[..Math.Min(80, _currentCallGuide.Scenario.Length)] + "...", correctAnswer, _codeTestWasCorrect);
        }
        _pendingFocus = FocusTarget.CodeTestNext;
    }

    private async Task NextCodeTestQuestion()
    {
        GenerateCodeTestQuestion();
        _pendingFocus = FocusTarget.CodeTestInput;
    }

    private void ResetCodeTestScore()
    {
        _codeTestCorrect = 0;
        _codeTestTotal = 0;
        _codeTestDeck.Reset();
        GenerateCodeTestQuestion();
    }

    private void OnCodeTestNoRepeatChanged(bool val)
    {
        _codeTestNoRepeat = val;
        _codeTestDeck.Reset();
        _codeTestCorrect = 0;
        _codeTestTotal = 0;
        GenerateCodeTestQuestion();
    }

    private async Task OnCodeTestKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (!_codeTestAnswered) await CheckCodeTestAnswer();
            else await NextCodeTestQuestion();
        }
    }
}
