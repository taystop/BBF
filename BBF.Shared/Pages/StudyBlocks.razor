    // ===== NO-REPEAT DECK HELPER =====

    private class Deck
    {
        private readonly List<int> _remaining = new();
        public int PoolSize { get; private set; }
        public List<(string Question, string Answer, bool WasCorrect)> History { get; } = new();
        public bool IsComplete { get; private set; }
        public int Remaining => _remaining.Count;

        public int Pick(int poolSize, Random rng)
        {
            if (_remaining.Count == 0 && History.Count > 0)
            {
                IsComplete = true;
                return -1;
            }
            if (_remaining.Count == 0) Shuffle(poolSize, rng);
            var idx = _remaining[^1];
            _remaining.RemoveAt(_remaining.Count - 1);
            return idx;
        }

        public void Record(string question, string answer, bool wasCorrect)
            => History.Add((question, answer, wasCorrect));

        public void Shuffle(int poolSize, Random rng)
        {
            PoolSize = poolSize;
            _remaining.Clear();
            _remaining.AddRange(Enumerable.Range(0, poolSize).OrderBy(_ => rng.Next()));
            History.Clear();
            IsComplete = false;
        }

        public void Reset()
        {
            _remaining.Clear();
            History.Clear();
            IsComplete = false;
            PoolSize = 0;
        }
    }

