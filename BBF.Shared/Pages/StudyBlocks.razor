    private bool _matchWasCorrect;
    private int _matchCorrect, _matchTotal;
    private bool _matchOnTestOnly = true;
    private bool _matchNoRepeat;
    private readonly Deck _matchDeck = new();

    protected override void OnInitialized()
    {
        GenerateMatchQuestion();
        GenerateNeighborQuestion();
        GenerateAddressQuestion();
        GenerateCityQuestion();
        GenerateRadioQuestion();
        GeneratePhoneticQuestion();
        GeneratePeopleQuestion();
