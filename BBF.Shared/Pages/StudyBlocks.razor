@page "/study-blocks"
@using Microsoft.AspNetCore.Components

<PageTitle>Call Taker Study - BBF</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
        <div>
            <MudText Typo="Typo.h4">Call Taker Study</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Sedgwick County Emergency Communications — Call Taker Academy
            </MudText>
        </div>
        <MudButton Href="/final-pretest" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Quiz">Final Exam Pretest</MudButton>
    </div>

    <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="2" Rounded ApplyEffectsToContainer Class="mb-4">

        @* amamamamam MAP QUIZ TAB amamamamam *@
        <MudTabPanel Text="Map Quiz" Icon="@Icons.Material.Filled.Map">
            <MudPaper Class="pa-4">
                <div class="d-flex align-center flex-wrap gap-2 mb-3">
                    <MudSwitch @bind-Value="_mapStudyMode" Label="Study Mode" Color="Color.Primary" T="bool" />
                    @if (!_mapStudyMode)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="ResetMap" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Refresh">Reset</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="RevealAllMap" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Visibility">Reveal All</MudButton>
                        <MudSpacer />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @MapCorrectCount of @_mapItems.Count correct
                        </MudText>
                    }
                </div>

                @if (!_mapStudyMode)
                {
                    <MudProgressLinear Value="@MapProgress" Color="Color.Success" Class="mb-4" Rounded="true" Size="Size.Large">
                        <MudText Typo="Typo.caption"><b>@MapCorrectCount / @_mapItems.Count</b></MudText>
                    </MudProgressLinear>
                }

                <MudGrid>
                    <MudItem xs="12" lg="8">
                        <MudPaper Elevation="3" Class="pa-0" Style="overflow:hidden;border-radius:8px;">
                            <div style="position:relative;line-height:0;">
                                @if (_mapStudyMode)
                                {
                                    <object data="images/sedgwick-county-map.svg" type="image/svg+xml"
                                            style="width:100%;height:auto;display:block;"></object>
                                }
                                else
                                {
                                    <object data="images/sedgwick-county-map-blank.svg?v=2" type="image/svg+xml"
                                            style="width:100%;height:auto;display:block;"></object>
                                    <svg viewBox="0 0 5000 3750" xmlns="http://www.w3.org/2000/svg"
                                         style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;font-family:'Arial',sans-serif;">
                                        @foreach (var item in _mapItems.Where(i => i.Category == "City"))
                                        {
                                            var fill = GetMarkerFill(item);
                                            <g style="pointer-events:auto;cursor:default;">
                                                <circle cx="@item.X" cy="@item.Y" r="55" fill="@fill" stroke="white" stroke-width="6" opacity="0.92" />
                                                @((MarkupString)$"<text x=\"{item.X}\" y=\"{item.Y + 14}\" text-anchor=\"middle\" fill=\"white\" font-size=\"38\" font-weight=\"bold\">{item.Label}</text>")
                                            </g>
                                        }
                                        @foreach (var item in _mapItems.Where(i => i.Category == "Road"))
                                        {
                                            var fill = GetMarkerFill(item);
                                            var w = item.Label.Length * 32 + 30;
                                            <g style="pointer-events:auto;cursor:default;">
                                                <rect x="@(item.X - w/2)" y="@(item.Y - 38)" width="@w" height="76" rx="14"
                                                      fill="@fill" stroke="white" stroke-width="5" opacity="0.92" />
                                                @((MarkupString)$"<text x=\"{item.X}\" y=\"{item.Y + 14}\" text-anchor=\"middle\" fill=\"white\" font-size=\"38\" font-weight=\"bold\">{item.Label}</text>")
                                            </g>
                                        }
                                        @foreach (var item in _mapItems.Where(i => i.Category == "County"))
                                        {
                                            var fill = GetMarkerFill(item);
                                            <g style="pointer-events:auto;cursor:default;">
                                                <rect x="@(item.X - 65)" y="@(item.Y - 42)" width="130" height="84" rx="14"
                                                      fill="@fill" stroke="white" stroke-width="5" opacity="0.92" />
                                                @((MarkupString)$"<text x=\"{item.X}\" y=\"{item.Y + 16}\" text-anchor=\"middle\" fill=\"white\" font-size=\"42\" font-weight=\"bold\">{item.Label}</text>")
                                            </g>
                                        }
                                    </svg>
                                }
                            </div>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" lg="4">
                        @if (!_mapStudyMode)
                        {
                            @if (MapCorrectCount == _mapItems.Count)
                            {
                                <MudAlert Severity="Severity.Success" Class="mb-3" Variant="Variant.Filled">
                                    Perfect score! All @_mapItems.Count items correct!
                                </MudAlert>
                            }

                            <MudExpansionPanels MultiExpansion="true" Elevation="2">
                                <MudExpansionPanel Expanded="true" Icon="@Icons.Material.Filled.LocationCity">
                                    <TitleContent>
                                        <div class="d-flex align-center gap-2">
                                            <MudText><b>Cities</b></MudText>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@MapCategoryCorrect("City") / @MapCategoryTotal("City")</MudChip>
                                        </div>
                                    </TitleContent>
                                    <ChildContent>
                                        @foreach (var item in _mapItems.Where(i => i.Category == "City"))
                                        {
                                            <MudTextField T="string" Value="@item.UserAnswer"
                                                          ValueChanged="@((string v) => OnMapValueChanged(item, v))"
                                                          Label="@item.Label" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-1"
                                                          Immediate="true" Disabled="@item.IsCorrect"
                                                          Adornment="Adornment.End" AdornmentIcon="@GetMapAdornmentIcon(item)"
                                                          AdornmentColor="@GetMapAdornmentColor(item)" Style="@GetMapInputStyle(item)" />
                                        }
                                    </ChildContent>
                                </MudExpansionPanel>
                                <MudExpansionPanel Expanded="true" Icon="@Icons.Material.Filled.EditRoad">
                                    <TitleContent>
                                        <div class="d-flex align-center gap-2">
                                            <MudText><b>Roads</b></MudText>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@MapCategoryCorrect("Road") / @MapCategoryTotal("Road")</MudChip>
                                        </div>
                                    </TitleContent>
                                    <ChildContent>
                                        @foreach (var item in _mapItems.Where(i => i.Category == "Road"))
                                        {
                                            <MudTextField T="string" Value="@item.UserAnswer"
                                                          ValueChanged="@((string v) => OnMapValueChanged(item, v))"
                                                          Label="@item.Label" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-1"
                                                          Immediate="true" Disabled="@item.IsCorrect"
                                                          Adornment="Adornment.End" AdornmentIcon="@GetMapAdornmentIcon(item)"
                                                          AdornmentColor="@GetMapAdornmentColor(item)" Style="@GetMapInputStyle(item)" />
                                        }
                                    </ChildContent>
                                </MudExpansionPanel>
                                <MudExpansionPanel Expanded="true" Icon="@Icons.Material.Filled.Map">
                                    <TitleContent>
                                        <div class="d-flex align-center gap-2">
                                            <MudText><b>Counties</b></MudText>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@MapCategoryCorrect("County") / @MapCategoryTotal("County")</MudChip>
                                        </div>
                                    </TitleContent>
                                    <ChildContent>
                                        @foreach (var item in _mapItems.Where(i => i.Category == "County"))
                                        {
                                            <MudTextField T="string" Value="@item.UserAnswer"
                                                          ValueChanged="@((string v) => OnMapValueChanged(item, v))"
                                                          Label="@item.Label" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-1"
                                                          Immediate="true" Disabled="@item.IsCorrect"
                                                          Adornment="Adornment.End" AdornmentIcon="@GetMapAdornmentIcon(item)"
                                                          AdornmentColor="@GetMapAdornmentColor(item)" Style="@GetMapInputStyle(item)" />
                                        }
                                    </ChildContent>
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                                Review the map to learn city, road, and county locations. When you're ready, turn off
                                <b>Study Mode</b> to quiz yourself.
                            </MudAlert>
                            <MudText Typo="Typo.h6" Class="mb-2">What to learn:</MudText>
                            <MudList T="string" Dense="true">
                                <MudListSubheader>18 Cities</MudListSubheader>
                                @foreach (var item in _mapItems.Where(i => i.Category == "City"))
                                {
                                    <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconColor="Color.Primary" IconSize="Size.Small">
                                        @item.CorrectAnswer
                                    </MudListItem>
                                }
                                <MudListSubheader>18 Roads</MudListSubheader>
                                @foreach (var item in _mapItems.Where(i => i.Category == "Road"))
                                {
                                    <MudListItem T="string" Icon="@Icons.Material.Filled.LinearScale" IconColor="Color.Secondary" IconSize="Size.Small">
                                        @item.CorrectAnswer
                                    </MudListItem>
                                }
                                <MudListSubheader>5 Surrounding Counties</MudListSubheader>
                                @foreach (var item in _mapItems.Where(i => i.Category == "County"))
                                {
                                    <MudListItem T="string" Icon="@Icons.Material.Filled.Map" IconColor="Color.Tertiary" IconSize="Size.Small">
                                        @item.CorrectAnswer
                                    </MudListItem>
                                }
                            </MudList>
                        }
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudTabPanel>

        @* amamamamam STUDY REFERENCE TAB amamamamam *@
        <MudTabPanel Text="Hundred Blocks" Icon="@Icons.Material.Filled.GridOn">
            <MudPaper Class="pa-4">
                <div class="d-flex align-center gap-2 mb-3">
                    <MudSwitch @bind-Value="_showOnTestOnly" Label="On-Test Only" Color="Color.Primary" T="bool" />
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">
                        @(_showOnTestOnly ? "Showing test items only" : "Showing all items (extra study in italics)")
                    </MudChip>
                    <MudSpacer />
                    <MudText Typo="Typo.caption" Color="Color.Info">E/W: 1 mi = 16 blocks &nbsp; N/S: 1 mi = 8 blocks</MudText>
                </div>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.h6" Class="mb-2">E/W Streets (North-South Running)</MudText>
                        <MudSimpleTable Dense Hover Bordered Striped>
                            <thead>
                                <tr>
                                    <th>Hundred Block</th>
                                    <th>Named Street</th>
                                    <th style="width:60px">On Test</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in EWStreets)
                                {
                                    if (_showOnTestOnly && !s.OnTest) continue;
                                    <tr style="@(!s.OnTest ? "font-style:italic;opacity:0.7" : "")">
                                        <td>@s.Display</td>
                                        <td>
                                            @if (s.AltName != null)
                                            {
                                                @s.AltName
                                                @if (s.AltNote != null)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary"> @s.AltNote</MudText>
                                                }
                                            }
                                        </td>
                                        <td style="text-align:center">
                                            @if (s.OnTest)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.h6" Class="mb-2">N/S Streets (East-West Running)</MudText>
                        <MudSimpleTable Dense Hover Bordered Striped>
                            <thead>
                                <tr>
                                    <th>Hundred Block</th>
                                    <th>Named Street</th>
                                    <th style="width:60px">On Test</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in NSStreets)
                                {
                                    if (_showOnTestOnly && !s.OnTest) continue;
                                    <tr style="@(!s.OnTest ? "font-style:italic;opacity:0.7" : "")">
                                        <td>@s.Display</td>
                                        <td>
                                            @if (s.AltName != null)
                                            {
                                                @s.AltName
                                                @if (s.AltNote != null)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary"> @s.AltNote</MudText>
                                                }
                                            }
                                        </td>
                                        <td style="text-align:center">
                                            @if (s.OnTest)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudTabPanel>

        @* amamamamam STREET MATCH TAB amamamamam *@
        <MudTabPanel Text="Street Match" Icon="@Icons.Material.Filled.SwapHoriz">
            <MudPaper Class="pa-4">
                <div class="d-flex align-center gap-2 mb-3">
                    <MudSwitch @bind-Value="_matchOnTestOnly" Label="On-Test Only" Color="Color.Primary" T="bool" />
                    <MudSwitch Value="_matchNoRepeat" ValueChanged="OnMatchNoRepeatChanged" Label="No Repeat" Color="Color.Secondary" T="bool" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="ResetMatchScore" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Refresh">Reset Score</MudButton>
                    <MudSpacer />
                    @if (_matchNoRepeat && _matchDeck.PoolSize > 0 && !_matchDeck.IsComplete)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@(_matchDeck.History.Count + 1) of @_matchDeck.PoolSize</MudChip>
                    }
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@_matchCorrect / @_matchTotal correct</MudChip>
                </div>

                @if (_matchNoRepeat && _matchDeck.IsComplete)
                {
                    <MudAlert Severity="Severity.Success" Class="mb-3" Variant="Variant.Filled">
                        Round complete! @_matchDeck.History.Count(h => h.WasCorrect) of @_matchDeck.History.Count correct
                    </MudAlert>
                    @if (_matchDeck.History.Any(h => !h.WasCorrect))
                    {
                        <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Error">Missed Questions:</MudText>
                        @foreach (var m in _matchDeck.History.Where(h => !h.WasCorrect))
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-1" Dense="true">
                                @m.Question — <b>@m.Answer</b>
                            </MudAlert>
                        }
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Success" Class="mb-2">Perfect score!</MudAlert>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2"
                               OnClick="@(() => { _matchDeck.Reset(); _matchCorrect = 0; _matchTotal = 0; GenerateMatchQuestion(); })"
                               StartIcon="@Icons.Material.Filled.Refresh">New Round</MudButton>
                }
                else if (_matchQuestion != null)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3" NoIcon>
                        <MudText Typo="Typo.h6">@_matchQuestion.Prompt</MudText>
                    </MudAlert>

                    <div class="d-flex align-center gap-2 mb-3">
                        <MudTextField @ref="_matchInput" @bind-Value="_matchUserAnswer" T="string" Label="Your Answer"
                                      Variant="Variant.Outlined" Immediate OnKeyDown="OnMatchKeyDown"
                                      Disabled="_matchAnswered"
                                      Style="max-width:400px" />
                        @if (!_matchAnswered)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CheckMatchAnswer"
                                       StartIcon="@Icons.Material.Filled.Check">Check</MudButton>
                        }
                        else
                        {
                            <MudButton @ref="_matchNextBtn" Variant="Variant.Filled" Color="Color.Primary" OnClick="NextMatchQuestion"
                                       StartIcon="@Icons.Material.Filled.ArrowForward">Next</MudButton>
                        }
                    </div>

                    @if (_matchAnswered)
                    {
                        @if (_matchWasCorrect)
                        {
                            <MudAlert Severity="Severity.Success" Class="mb-2">Correct!</MudAlert>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-2">
                                Incorrect. The answer is: <b>@_matchQuestion.Answer</b>
                                @if (_matchQuestion.AnswerNote != null)
                                {
                                    <span> @_matchQuestion.AnswerNote</span>
                                }
                            </MudAlert>
                        }
                    }
                }
            </MudPaper>
        </MudTabPanel>

        @* amamamamam NEIGHBORS TAB amamamamam *@
        <MudTabPanel Text="Neighbors" Icon="@Icons.Material.Filled.CompareArrows">
            <MudPaper Class="pa-4">
                <div class="d-flex align-center gap-2 mb-3">
                    <MudSwitch @bind-Value="_neighborOnTestOnly" Label="On-Test Only" Color="Color.Primary" T="bool" />
                    <MudSwitch Value="_neighborNoRepeat" ValueChanged="OnNeighborNoRepeatChanged" Label="No Repeat" Color="Color.Secondary" T="bool" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="ResetNeighborScore" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Refresh">Reset Score</MudButton>
                    <MudSpacer />
                    @if (_neighborNoRepeat && _neighborDeck.PoolSize > 0 && !_neighborDeck.IsComplete)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@(_neighborDeck.History.Count + 1) of @_neighborDeck.PoolSize</MudChip>
                    }
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@_neighborCorrect / @_neighborTotal correct</MudChip>
                </div>

                @if (_neighborNoRepeat && _neighborDeck.IsComplete)
                {
                    <MudAlert Severity="Severity.Success" Class="mb-3" Variant="Variant.Filled">
                        Round complete! @_neighborDeck.History.Count(h => h.WasCorrect) of @_neighborDeck.History.Count correct
                    </MudAlert>
                    @if (_neighborDeck.History.Any(h => !h.WasCorrect))
                    {
                        <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Error">Missed Questions:</MudText>
                        @foreach (var m in _neighborDeck.History.Where(h => !h.WasCorrect))
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-1" Dense="true">
                                @m.Question — <b>@m.Answer</b>
                            </MudAlert>
                        }
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Success" Class="mb-2">Perfect score!</MudAlert>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2"
                               OnClick="@(() => { _neighborDeck.Reset(); _neighborCorrect = 0; _neighborTotal = 0; GenerateNeighborQuestion(); })"
                               StartIcon="@Icons.Material.Filled.Refresh">New Round</MudButton>
                }
                else if (_neighborQuestion != null)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3" NoIcon>
                        <MudText Typo="Typo.h6">@_neighborQuestion.Prompt</MudText>
                    </MudAlert>

                    <MudGrid>
                        @if (_neighborQuestion.HasBefore)
                        {
                            <MudItem xs="12" sm="6">
                                <MudTextField @ref="_neighborInput" @bind-Value="_neighborAnswer1" T="string"
                                              Label="@_neighborQuestion.BeforeLabel"
                                              Variant="Variant.Outlined" Immediate
                                              Disabled="_neighborAnswered" />
                            </MudItem>
                        }
                        @if (_neighborQuestion.HasAfter)
                        {
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_neighborAnswer2" T="string"
                                              Label="@_neighborQuestion.AfterLabel"
                                              Variant="Variant.Outlined" Immediate
                                              Disabled="_neighborAnswered" />
                            </MudItem>
                        }
                    </MudGrid>

                    <div class="d-flex align-center gap-2 mt-3">
                        @if (!_neighborAnswered)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CheckNeighborAnswer"
                                       StartIcon="@Icons.Material.Filled.Check">Check</MudButton>
                        }
                        else
                        {
                            <MudButton @ref="_neighborNextBtn" Variant="Variant.Filled" Color="Color.Primary" OnClick="NextNeighborQuestion"
                                       StartIcon="@Icons.Material.Filled.ArrowForward">Next</MudButton>
                        }
                    </div>

                    @if (_neighborAnswered)
                    {
                        <MudAlert Severity="@(_neighborWasCorrect ? Severity.Success : Severity.Error)" Class="mt-2">
                            @if (_neighborWasCorrect)
                            {
                                <span>Correct!</span>
                            }
                            else
                            {
                                <span>
                                    @if (_neighborQuestion.HasBefore)
                                    {
                                        <div>@_neighborQuestion.BeforeLabel: <b>@_neighborQuestion.BeforeAnswer</b></div>
                                    }
                                    @if (_neighborQuestion.HasAfter)
                                    {
                                        <div>@_neighborQuestion.AfterLabel: <b>@_neighborQuestion.AfterAnswer</b></div>
                                    }
                                </span>
                            }
                        </MudAlert>
                    }
                }
            </MudPaper>
        </MudTabPanel>

        @* amamamamam ADDRESS LOOKUP TAB amamamamam *@
        <MudTabPanel Text="Address Lookup" Icon="@Icons.Material.Filled.LocationOn">
            <MudPaper Class="pa-4">
                <div class="d-flex align-center gap-2 mb-3">
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="ResetAddressScore" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Refresh">Reset Score</MudButton>
                    <MudSpacer />
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@_addrCorrect / @_addrTotal correct</MudChip>
                </div>

                @if (_addrQuestion != null)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3" NoIcon>
                        <MudText Typo="Typo.h5">@_addrQuestion.Address</MudText>
                    </MudAlert>

                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField @ref="_addrInput" @bind-Value="_addrCrossStreet" T="string"
                                          Label="Nearest cross street"
                                          Variant="Variant.Outlined" Immediate
                                          Disabled="_addrAnswered"
                                          HelperText="The nearest street from the hundred blocks list" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="_addrSide" T="string" Label="Which side of the street?"
                                       Variant="Variant.Outlined" Disabled="_addrAnswered">
                                <MudSelectItem Value="@("North")">North</MudSelectItem>
                                <MudSelectItem Value="@("South")">South</MudSelectItem>
                                <MudSelectItem Value="@("East")">East</MudSelectItem>
                                <MudSelectItem Value="@("West")">West</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    <div class="d-flex align-center gap-2 mt-3">
                        @if (!_addrAnswered)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CheckAddressAnswer"
                                       StartIcon="@Icons.Material.Filled.Check">Check</MudButton>
                        }
                        else
                        {
                            <MudButton @ref="_addrNextBtn" Variant="Variant.Filled" Color="Color.Primary" OnClick="NextAddressQuestion"
                                       StartIcon="@Icons.Material.Filled.ArrowForward">Next</MudButton>
                        }
                    </div>

                    @if (_addrAnswered)
                    {
                        <div class="mt-2">
                            <MudAlert Severity="@(_addrCrossCorrect ? Severity.Success : Severity.Error)" Class="mb-1">
                                Cross street: <b>@_addrQuestion.CrossStreetAnswer</b>
                                @if (_addrQuestion.CrossStreetAlt != null)
                                {
                                    <span> (@_addrQuestion.CrossStreetAlt)</span>
                                }
                                — you said: <b>@(string.IsNullOrWhiteSpace(_addrCrossStreet) ? "(blank)" : _addrCrossStreet)</b>
                            </MudAlert>
                            <MudAlert Severity="@(_addrSideCorrect ? Severity.Success : Severity.Error)">
