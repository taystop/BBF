@page "/budget"
@using BBF.Shared.Contracts.Budget
@using BBF.Shared.Contracts.Transactions
@attribute [Authorize]
@inject IBudgetPeriodService BudgetPeriodSvc
@inject IBudgetCategoryService CategorySvc
@inject ITransactionService TransactionSvc
@inject ApiGroupContext GroupContext
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Budget - BBF</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    @if (!GroupContext.IsInitialized || GroupContext.ActiveGroupId is null)
    {
        <MudPaper Class="pa-6 text-center" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
            <MudText Typo="Typo.h5" Class="mb-2">No Budget Group</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                Create or join a group to start tracking your budget. Groups let you share budget data with family members.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/groups"
                       StartIcon="@Icons.Material.Filled.GroupAdd">
                Manage Groups
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudStack Row AlignItems="AlignItems.Center" Style="flex-wrap: wrap; gap: 8px;" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h4">Budget</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="PreviousMonth" />
            <MudText Typo="Typo.h6">@_selectedMonth.ToString("MMMM yyyy")</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="NextMonth"
                           Disabled="@(_selectedMonth >= new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))" />
            @if (_period is not null && _period.Status == "Open")
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.EventAvailable" OnClick="ClosePeriod">
                    Close Period
                </MudButton>
            }
            @if (_period is not null && _period.Status == "Closed")
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default">Closed</MudChip>
            }
        </MudStack>

        @if (_period is null)
        {
            <MudPaper Class="pa-6 text-center" Elevation="2">
                <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                <MudText Typo="Typo.h6" Class="mb-2">No budget data for this period</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    This month predates budget period tracking, so there's nothing recorded here.
                </MudText>
            </MudPaper>
        }
        else
        {
            @* Summary cards *@
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-4" Elevation="2">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Budget</MudText>
                        <MudText Typo="Typo.h5">@_totalBudget.ToString("C")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-4" Elevation="2">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Spent</MudText>
                        <MudText Typo="Typo.h5" Color="@(_totalSpent > _totalBudget ? Color.Error : Color.Default)">
                            @_totalSpent.ToString("C")
                        </MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-4" Elevation="2">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Remaining</MudText>
                        <MudText Typo="Typo.h5" Color="@(_totalBudget - _totalSpent >= 0 ? Color.Success : Color.Error)">
                            @((_totalBudget - _totalSpent).ToString("C"))
                        </MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row AlignItems="AlignItems.Center" Style="flex-wrap: wrap; gap: 8px;" Class="mb-3">
                    <MudText Typo="Typo.h6">Budget Categories</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddCategory">
                        Add Category
                    </MudButton>
                </MudStack>

                @foreach (var topCategory in _categories.Where(c => c.ParentCategoryId is null).OrderBy(c => c.SortOrder))
                {
                    var topItem = _lineItems.FirstOrDefault(li => li.Category.Id == topCategory.Id);
                    if (topItem is not null)
                    {
                        @RenderCategoryRow(topItem, false)
                    }
                    @foreach (var child in _categories.Where(c => c.ParentCategoryId == topCategory.Id).OrderBy(c => c.SortOrder))
                    {
                        var childItem = _lineItems.FirstOrDefault(li => li.Category.Id == child.Id);
                        if (childItem is not null)
                        {
                            @RenderCategoryRow(childItem, true)
                        }
                    }
                }

                @if (_lineItems.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
                        No budget categories yet. Add one to start tracking spending.
                    </MudText>
                }
            </MudPaper>
        }
    }
</MudContainer>

@code {
    private DateTime _selectedMonth = new(DateTime.Now.Year, DateTime.Now.Month, 1);
    private BudgetPeriodDto? _period;
    private List<BudgetCategoryDto> _categories = [];
    private List<LineItemSpending> _lineItems = [];
    private decimal _totalBudget;
    private decimal _totalSpent;

    protected override async Task OnInitializedAsync()
    {
        GroupContext.OnGroupChanged += OnGroupChanged;
        if (GroupContext.ActiveGroupId is not null)
            await LoadData();
    }

    private async void OnGroupChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    private async Task LoadData()
    {
        var groupId = GroupContext.ActiveGroupId;
        if (groupId is null) return;

        _categories = await CategorySvc.GetCategoriesAsync(groupId.Value);

        var isCurrentMonth = _selectedMonth == new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        _period = isCurrentMonth
            ? await BudgetPeriodSvc.GetOrCreateCurrentPeriodAsync(groupId.Value)
            : await BudgetPeriodSvc.GetPeriodAsync(groupId.Value, _selectedMonth);

        if (_period is null)
        {
            _lineItems = [];
            _totalBudget = 0;
            _totalSpent = 0;
            StateHasChanged();
            return;
        }

        var allTransactions = await TransactionSvc.GetTransactionsAsync(groupId.Value);
        var spentByCategory = allTransactions
            .Where(t => t.CategoryId.HasValue && t.Date >= _period.StartDate && t.Date < _period.EndDate && t.Amount > 0)
            .GroupBy(t => t.CategoryId!.Value)
            .ToDictionary(g => g.Key, g => g.Sum(t => t.Amount));

        _lineItems = _period.LineItems.Select(li =>
        {
            var category = _categories.FirstOrDefault(c => c.Id == li.CategoryId)
                ?? new BudgetCategoryDto(li.CategoryId, li.CategoryName, 0, li.CategoryColor, null, 0, true, "Reset", null);
            return new LineItemSpending
            {
                Category = category,
                BudgetedAmount = li.BudgetedAmount,
                RolledOverAmount = li.RolledOverAmount,
                EditAmount = li.BudgetedAmount,
                Spent = spentByCategory.GetValueOrDefault(li.CategoryId, 0)
            };
        }).ToList();

        _totalBudget = _lineItems.Sum(li => li.EffectiveBudget);
        _totalSpent = _lineItems.Sum(li => li.Spent);

        StateHasChanged();
    }

    private void PreviousMonth() { _selectedMonth = _selectedMonth.AddMonths(-1); _ = LoadData(); }
    private void NextMonth() { _selectedMonth = _selectedMonth.AddMonths(1); _ = LoadData(); }

    private async Task ClosePeriod()
    {
        if (_period is null) return;

        var parameters = new DialogParameters<MessageBoxDialog>
        {
            { x => x.ContentText, $"Close the budget period for {_selectedMonth:MMMM yyyy}? This locks it and opens next month, applying rollover for any category flagged to roll over." },
            { x => x.ButtonText, "Close Period" },
            { x => x.Color, Color.Warning }
        };
        var dialog = await DialogService.ShowAsync<MessageBoxDialog>("Close Period", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await BudgetPeriodSvc.ClosePeriodAsync(GroupContext.ActiveGroupId!.Value, _period.Id);
            Snackbar.Add("Period closed.", Severity.Success);
            await LoadData();
        }
    }

    private async Task SaveLineItemAmount(LineItemSpending item)
    {
        if (_period is null) return;
        await BudgetPeriodSvc.UpsertLineItemAsync(GroupContext.ActiveGroupId!.Value, _period.Id,
            new UpsertLineItemRequest(item.Category.Id, item.EditAmount));
        Snackbar.Add($"Updated budget for '{item.Category.Name}'.", Severity.Success);
        await LoadData();
    }

    // --- Category CRUD ---

    private async Task AddCategory()
    {
        var parameters = new DialogParameters<BudgetCategoryDialog>
        {
            { x => x.IsNew, true },
            { x => x.AvailableParents, _categories.Where(c => c.ParentCategoryId is null).ToList() }
        };
        var dialog = await DialogService.ShowAsync<BudgetCategoryDialog>("Add Category", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is BudgetCategoryDialog.CategoryResult data)
        {
            await CategorySvc.CreateAsync(GroupContext.ActiveGroupId!.Value, data.ToRequest(0));
            await LoadData();
        }
    }

    private async Task EditCategory(BudgetCategoryDto category)
    {
        var parameters = new DialogParameters<BudgetCategoryDialog>
        {
            { x => x.IsNew, false },
            { x => x.Name, category.Name },
            { x => x.MonthlyLimit, category.MonthlyLimit },
            { x => x.ColorHex, category.Color },
            { x => x.Icon, category.Icon },
            { x => x.SortOrder, category.SortOrder },
            { x => x.IsActive, category.IsActive },
            { x => x.ParentCategoryId, category.ParentCategoryId },
            { x => x.RolloverBehavior, category.RolloverBehavior },
            { x => x.AvailableParents, _categories.Where(c => c.ParentCategoryId is null && c.Id != category.Id).ToList() }
        };
        var dialog = await DialogService.ShowAsync<BudgetCategoryDialog>("Edit Category", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is BudgetCategoryDialog.CategoryResult data)
        {
            await CategorySvc.UpdateAsync(GroupContext.ActiveGroupId!.Value, category.Id, data.ToRequest(category.Id));
            await LoadData();
        }
    }

    private async Task DeleteCategory(BudgetCategoryDto category)
    {
        var parameters = new DialogParameters<MessageBoxDialog>
        {
            { x => x.ContentText, $"Delete category '{category.Name}'? Transactions will become uncategorized." },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };
        var dialog = await DialogService.ShowAsync<MessageBoxDialog>("Delete Category", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            var deleteResult = await CategorySvc.DeleteAsync(GroupContext.ActiveGroupId!.Value, category.Id);
            if (!deleteResult.Deleted)
            {
                Snackbar.Add($"'{category.Name}' {deleteResult.BlockedReason}", Severity.Warning);
                return;
            }
            await LoadData();
        }
    }

    private RenderFragment RenderCategoryRow(LineItemSpending item, bool indented) => @<text>
        <MudPaper Class="@($"pa-3 mb-2{(indented ? " ml-4 ml-sm-8" : "")}")" Elevation="1">
            @{
                var pct = item.EffectiveBudget > 0 ? (double)(item.Spent / item.EffectiveBudget) * 100 : 0;
                var color = pct >= 100 ? Color.Error : pct >= 80 ? Color.Warning : Color.Success;
            }
            @* Desktop layout: single row *@
            <div class="d-none d-sm-flex align-center" style="gap: 12px;">
                <div style="width: 8px; height: 40px; border-radius: 4px; background-color: @item.Category.Color;"></div>
                <MudStack Spacing="0" Style="min-width: 150px;">
                    <MudText Typo="Typo.subtitle2">
                        @item.Category.Name
                        @if (item.Category.RolloverBehavior == "RollOver")
                        {
                            <MudTooltip Text="Rolls over unspent balance">
                                <MudIcon Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small" Class="ml-1" />
                            </MudTooltip>
                        }
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @item.Spent.ToString("C") spent
                    </MudText>
                </MudStack>
                <MudNumericField T="decimal" @bind-Value="item.EditAmount" Format="N2" Dense
                                 Variant="Variant.Outlined" Style="max-width: 140px;"
                                 Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Save"
                                 OnAdornmentClick="@(() => SaveLineItemAmount(item))" />
                <MudProgressLinear Value="@Math.Min(pct, 100)" Color="@color"
                                  Style="flex: 1;" Size="Size.Large" Rounded />
                <MudText Typo="Typo.body2" Color="@(item.Remaining >= 0 ? Color.Success : Color.Error)"
                         Style="min-width: 80px; text-align: right;">
                    @item.Remaining.ToString("C")
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => EditCategory(item.Category))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               Color="Color.Error"
                               OnClick="@(() => DeleteCategory(item.Category))" />
            </div>

            @* Mobile layout: stacked *@
            <div class="d-flex d-sm-none flex-column" style="gap: 8px;">
                <div class="d-flex align-center" style="gap: 8px;">
                    <div style="width: 6px; height: 32px; border-radius: 3px; background-color: @item.Category.Color;"></div>
                    <MudStack Spacing="0" Style="flex: 1; min-width: 0;">
                        <MudText Typo="Typo.subtitle2">@item.Category.Name</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @item.Spent.ToString("C") / @item.EffectiveBudget.ToString("C")
                        </MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2" Color="@(item.Remaining >= 0 ? Color.Success : Color.Error)"
                             Style="white-space: nowrap;">
                        @item.Remaining.ToString("C")
                    </MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => EditCategory(item.Category))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(() => DeleteCategory(item.Category))" />
                </div>
                <MudProgressLinear Value="@Math.Min(pct, 100)" Color="@color"
                                  Size="Size.Medium" Rounded />
            </div>
        </MudPaper>
    </text>;

    public void Dispose()
    {
        GroupContext.OnGroupChanged -= OnGroupChanged;
    }

    private class LineItemSpending
    {
        public BudgetCategoryDto Category { get; init; } = null!;
        public decimal BudgetedAmount { get; init; }
        public decimal RolledOverAmount { get; init; }
        public decimal Spent { get; init; }
        public decimal EditAmount { get; set; }
        public decimal EffectiveBudget => BudgetedAmount + RolledOverAmount;
        public decimal Remaining => EffectiveBudget - Spent;
    }
}
