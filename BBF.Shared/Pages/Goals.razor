@page "/goals"
@using BBF.Shared.Contracts.Accounts
@using BBF.Shared.Contracts.Goals
@attribute [Authorize]
@inject IGoalService GoalSvc
@inject IAccountService AccountSvc
@inject ApiGroupContext GroupContext
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Goals - BBF</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    @if (!GroupContext.IsInitialized || GroupContext.ActiveGroupId is null)
    {
        <MudPaper Class="pa-6 text-center" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
            <MudText Typo="Typo.h5" Class="mb-2">No Budget Group</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                Create or join a group to start tracking your budget. Groups let you share budget data with family members.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/groups"
                       StartIcon="@Icons.Material.Filled.GroupAdd">
                Manage Groups
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudStack Row AlignItems="AlignItems.Center" Style="flex-wrap: wrap; gap: 8px;" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Flag" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h4">Goals</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="AddGoal">
                Add Goal
            </MudButton>
        </MudStack>

        <MudGrid>
            @foreach (var goal in _goals)
            {
                var pct = goal.TargetAmount > 0 ? (double)(goal.ProgressAmount / goal.TargetAmount) * 100 : 0;

                <MudItem xs="12" sm="6" md="4">
                    <MudPaper Class="pa-4" Elevation="2">
                        <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">
                            <MudText Typo="Typo.h6" Style="flex: 1;">
                                @goal.Name
                                @if (!goal.IsActive)
                                {
                                    <MudChip T="string" Size="Size.Small" Class="ml-2">Inactive</MudChip>
                                }
                            </MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           OnClick="@(() => EditGoal(goal))" />
                            <MudIconButton Icon="@(goal.IsActive ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                           Size="Size.Small"
                                           OnClick="@(() => ToggleActive(goal))" />
                        </MudStack>
                        @if (goal.AccountName is not null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">@goal.AccountName</MudText>
                        }
                        <MudProgressLinear Value="@Math.Min(pct, 100)" Color="@(pct >= 100 ? Color.Success : Color.Primary)"
                                          Size="Size.Large" Rounded Class="mb-2" />
                        <MudStack Row Justify="Justify.SpaceBetween" Class="mb-3">
                            <MudText Typo="Typo.body2">@goal.ProgressAmount.ToString("C") of @goal.TargetAmount.ToString("C")</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@pct.ToString("N0")%</MudText>
                        </MudStack>
                        @if (goal.TargetDate is not null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                                Target: @goal.TargetDate.Value.ToString("MMM d, yyyy")
                            </MudText>
                        }
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth
                                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddContribution(goal))">
                            Add Contribution
                        </MudButton>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        @if (_goals.Count == 0)
        {
            <MudPaper Class="pa-6 text-center" Elevation="2">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    No goals yet. Add one to start tracking savings progress.
                </MudText>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    private List<GoalDto> _goals = [];
    private List<AccountDto> _accounts = [];

    protected override async Task OnInitializedAsync()
    {
        GroupContext.OnGroupChanged += OnGroupChanged;
        if (GroupContext.ActiveGroupId is not null)
            await LoadData();
    }

    private async void OnGroupChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    private async Task LoadData()
    {
        var groupId = GroupContext.ActiveGroupId;
        if (groupId is null) return;

        _goals = await GoalSvc.GetGoalsAsync(groupId.Value);
        _accounts = await AccountSvc.GetAccountsAsync(groupId.Value);

        StateHasChanged();
    }

    private async Task AddGoal()
    {
        var parameters = new DialogParameters<GoalDialog>
        {
            { x => x.IsNew, true },
            { x => x.Accounts, _accounts }
        };
        var dialog = await DialogService.ShowAsync<GoalDialog>("Add Goal", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is GoalDialog.GoalResult data)
        {
            await GoalSvc.CreateAsync(GroupContext.ActiveGroupId!.Value, new CreateGoalRequest(
                data.Name, data.TargetAmount, data.TargetDate, data.AccountId));
            Snackbar.Add($"Goal '{data.Name}' created.", Severity.Success);
            await LoadData();
        }
    }

    private async Task EditGoal(GoalDto goal)
    {
        var parameters = new DialogParameters<GoalDialog>
        {
            { x => x.IsNew, false },
            { x => x.Name, goal.Name },
            { x => x.TargetAmount, goal.TargetAmount },
            { x => x.TargetDate, goal.TargetDate },
            { x => x.AccountId, goal.AccountId },
            { x => x.IsActive, goal.IsActive },
            { x => x.Accounts, _accounts }
        };
        var dialog = await DialogService.ShowAsync<GoalDialog>("Edit Goal", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is GoalDialog.GoalResult data)
        {
            var groupId = GroupContext.ActiveGroupId!.Value;
            await GoalSvc.UpdateAsync(groupId, goal.Id, new UpdateGoalRequest(data.Name, data.TargetAmount, data.TargetDate, data.AccountId));
            if (data.IsActive != goal.IsActive)
                await GoalSvc.SetActiveAsync(groupId, goal.Id, data.IsActive);
            await LoadData();
        }
    }

    private async Task ToggleActive(GoalDto goal)
    {
        await GoalSvc.SetActiveAsync(GroupContext.ActiveGroupId!.Value, goal.Id, !goal.IsActive);
        await LoadData();
    }

    private async Task AddContribution(GoalDto goal)
    {
        var parameters = new DialogParameters<GoalContributionDialog>();
        var dialog = await DialogService.ShowAsync<GoalContributionDialog>($"Contribute to '{goal.Name}'", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is GoalContributionDialog.GoalContributionResult data)
        {
            await GoalSvc.AddContributionAsync(GroupContext.ActiveGroupId!.Value, goal.Id,
                new AddGoalContributionRequest(data.Amount, data.ContributedAt, null));
            Snackbar.Add("Contribution added.", Severity.Success);
            await LoadData();
        }
    }

    public void Dispose()
    {
        GroupContext.OnGroupChanged -= OnGroupChanged;
    }
}
