@page "/chat"
@page "/chat/{ConversationId:int}"
@using BBF.Shared.Contracts.Auth
@using BBF.Shared.Contracts.Chat
@using Markdig
@attribute [Authorize]
@inject IChatService ChatSvc
@inject IGroupService GroupSvc
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>AI Chat - BBF</PageTitle>

@* Mobile: toggle sidebar button + full-width chat *@
<div class="chat-root">
    @* Sidebar — visible on md+, or toggled on mobile *@
    <div class="chat-sidebar @(_sidebarOpen ? "open" : "")">
        <MudPaper Class="pa-3 d-flex flex-column" Style="height: 100%;" Elevation="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth
                       StartIcon="@Icons.Material.Filled.Add" OnClick="NewConversation"
                       Class="mb-3">
                New Chat
            </MudButton>

            <MudTextField @bind-Value="_searchText" Placeholder="Search..."
                          Variant="Variant.Outlined" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate
                          Class="mb-2" Margin="Margin.Dense" />

            <MudDivider Class="mb-2" />

            <div style="overflow-y: auto; flex: 1;">
                @if (_conversations.Any())
                {
                    @foreach (var convo in FilteredConversations)
                    {
                        <MudNavLink Href="@($"/chat/{convo.Id}")"
                                    Match="NavLinkMatch.All"
                                    Icon="@(convo.IsShared ? Icons.Material.Filled.Share : Icons.Material.Filled.ChatBubbleOutline)"
                                    Class="@(convo.Id == ConversationId ? "mud-nav-link-active" : "")">
                            <div class="d-flex align-center justify-space-between" style="width: 100%;">
                                <MudText Typo="Typo.body2" Class="text-truncate" Style="flex: 1; min-width: 0;">
                                    @(convo.Title ?? "New Chat")
                                </MudText>
                                @if (!convo.IsShared)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DeleteConversation(convo.Id))"
                                                   onclick:stopPropagation />
                                }
                            </div>
                        </MudNavLink>
                    }
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-3 text-center">
                        No conversations yet
                    </MudText>
                }
            </div>
        </MudPaper>
    </div>

    @* Backdrop for mobile sidebar *@
    @if (_sidebarOpen)
    {
        <div class="chat-backdrop" @onclick="ToggleSidebar"></div>
    }

    @* Chat area *@
    <div class="chat-main">
        <MudPaper Class="d-flex flex-column" Style="height: 100%;" Elevation="2">
            @* Header *@
            <MudToolBar Dense Class="border-b" Style="flex-wrap: wrap; gap: 4px;">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Size="Size.Small"
                               OnClick="ToggleSidebar" Class="d-md-none" />
                <MudText Typo="Typo.h6" Class="text-truncate" Style="flex: 1; min-width: 0;">
                    @(_activeConversation?.Title ?? "New Chat")
                </MudText>
                @if (_activeConversation is not null && _activeConversation.IsOwnedByCaller)
                {
                    <MudTooltip Text="Share conversation">
                        <MudIconButton Icon="@Icons.Material.Filled.Share" Size="Size.Small"
                                       Color="@(_activeConversation.SharedGroupIds.Count > 0 ? Color.Info : Color.Default)"
                                       OnClick="ShowShareDialog" />
                    </MudTooltip>
                }
                <MudTooltip Text="@(_docsSearchEnabled ? "Docs search on" : "Docs search off")">
                    <MudToggleIconButton @bind-Toggled="_docsSearchEnabled"
                                         Icon="@Icons.Material.Filled.MenuBook"
                                         ToggledIcon="@Icons.Material.Filled.MenuBook"
                                         Color="Color.Default" ToggledColor="Color.Info"
                                         Size="Size.Small" />
                </MudTooltip>
                <MudTooltip Text="@(_webSearchEnabled ? "Web search on" : "Web search off")">
                    <MudToggleIconButton @bind-Toggled="_webSearchEnabled"
                                         Icon="@Icons.Material.Filled.TravelExplore"
                                         ToggledIcon="@Icons.Material.Filled.TravelExplore"
                                         Color="Color.Default" ToggledColor="Color.Success"
                                         Size="Size.Small" />
                </MudTooltip>
                @if (_availableModels.Any())
                {
                    <MudSelect T="string" @bind-Value="_selectedModel" Variant="Variant.Outlined"
                               Dense Margin="Margin.Dense" Style="max-width: 160px; min-width: 100px;"
                               Label="Model">
                        @foreach (var model in _availableModels)
                        {
                            <MudSelectItem Value="@model">@model</MudSelectItem>
                        }
                    </MudSelect>
                }
            </MudToolBar>

            @* Messages *@
            <div @ref="_messagesContainer" class="chat-messages pa-3 pa-sm-4" style="flex: 1; overflow-y: auto;">
                @if (_messages.Any() || _isStreaming)
                {
                    @foreach (var msg in _messages)
                    {
                        <div class="d-flex mb-3 @(msg.Role == "user" ? "justify-end" : "justify-start")">
                            @if (msg.Role != "user")
                            {
                                <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-2 mt-1 d-none d-sm-flex">
                                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" />
                                </MudAvatar>
                            }
                            <MudPaper Class="@($"pa-3 {(msg.Role == "user" ? "user-message" : "assistant-message")}")"
                                      Elevation="1"
                                      Style="@($"max-width: min(85%, 600px); {(msg.Role == "user" ? "background-color: var(--mud-palette-primary); color: var(--mud-palette-primary-text);" : "")}")">
                                @if (msg.Role == "user")
                                {
                                    <MudText Style="white-space: pre-wrap; word-break: break-word;">@msg.Content</MudText>
                                }
                                else
                                {
                                    <div class="markdown-body">@((MarkupString)RenderMarkdown(StripWikiBlocks(msg.Content)))</div>
                                    @if (HasWikiBlock(msg.Content))
                                    {
                                        <MudAlert Severity="Severity.Success" Dense Class="mt-2" NoIcon>
                                            Wiki article created automatically
                                        </MudAlert>
                                    }
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.MenuBook" Class="mt-1"
                                               OnClick="@(() => SaveToWiki(msg))">
                                        Save to Wiki
                                    </MudButton>
                                }
                            </MudPaper>
                            @if (msg.Role == "user")
                            {
                                <MudAvatar Color="Color.Secondary" Size="Size.Small" Class="ml-2 mt-1 d-none d-sm-flex">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                </MudAvatar>
                            }
                        </div>
                    }

                    @if (_isStreaming)
                    {
                        <div class="d-flex mb-3 justify-start">
                            <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-2 mt-1 d-none d-sm-flex">
                                <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" />
                            </MudAvatar>
                            <MudPaper Class="pa-3 assistant-message" Elevation="1" Style="max-width: min(85%, 600px);">
                                @if (!string.IsNullOrEmpty(_streamingContent))
                                {
                                    <div class="markdown-body">@((MarkupString)RenderMarkdown(_streamingContent))</div>
                                }
                                else
                                {
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                        <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate />
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                                            Generating...
                                        </MudText>
                                    </MudStack>
                                }
                                <MudProgressLinear Color="Color.Primary" Indeterminate Size="Size.Small" Class="mt-2" />
                            </MudPaper>
                        </div>
                    }
                }
                else
                {
                    <div class="d-flex flex-column align-center justify-center" style="height: 100%;">
                        <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Large"
                                 Color="Color.Primary" Class="mb-4" />
                        <MudText Typo="Typo.h5" Color="Color.Secondary">How can I help you?</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                            Start a conversation with your local AI assistant.
                        </MudText>
                    </div>
                }
            </div>

            @* Input area *@
            <MudPaper Class="pa-2 pa-sm-3 border-t" Elevation="0">
                <MudStack Row AlignItems="AlignItems.End">
                    <MudTextField @bind-Value="_userInput" Placeholder="Type a message..."
                                  Variant="Variant.Outlined" autoGrow Lines="1" MaxLines="5"
                                  Immediate FullWidth Disabled="_isStreaming"
                                  OnKeyDown="HandleKeyDown" />
                    @if (_isStreaming)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Stop" Color="Color.Error"
                                       Variant="Variant.Filled" OnClick="StopStreaming"
                                       title="Stop generating" />
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary"
                                       Variant="Variant.Filled" OnClick="SendMessage"
                                       Disabled="@(string.IsNullOrWhiteSpace(_userInput))"
                                       title="Send message" />
                    }
                </MudStack>
            </MudPaper>
        </MudPaper>
    </div>
</div>

<style>
    .chat-root {
        display: flex;
        height: calc(100dvh - 64px - 16px);
        gap: 0;
        position: relative;
    }

    .chat-sidebar {
        width: 280px;
        min-width: 280px;
        height: 100%;
    }

    .chat-main {
        flex: 1;
        min-width: 0;
        height: 100%;
    }

    .chat-backdrop {
        display: none;
    }

    /* Mobile: sidebar as overlay drawer */
    @@media (max-width: 959.98px) {
        .chat-sidebar {
            position: fixed;
            top: 64px;
            left: 0;
            bottom: 0;
            z-index: 1100;
            transform: translateX(-100%);
            transition: transform 0.2s ease;
        }

        .chat-sidebar.open {
            transform: translateX(0);
        }

        .chat-backdrop {
            display: block;
            position: fixed;
            inset: 0;
            z-index: 1099;
            background: rgba(0, 0, 0, 0.5);
        }
    }

    .chat-messages::-webkit-scrollbar {
        width: 6px;
    }

    .chat-messages::-webkit-scrollbar-thumb {
        background-color: var(--mud-palette-lines-default);
        border-radius: 3px;
    }

    .border-b {
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }

    .border-t {
        border-top: 1px solid var(--mud-palette-lines-default);
    }

    .text-truncate {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .assistant-message {
        border-radius: 4px 16px 16px 16px !important;
    }

    .user-message {
        border-radius: 16px 4px 16px 16px !important;
    }

    .markdown-body {
        word-break: break-word;
        line-height: 1.6;
    }

    .markdown-body p {
        margin: 0 0 0.5em 0;
    }

    .markdown-body p:last-child {
        margin-bottom: 0;
    }

    .markdown-body ul, .markdown-body ol {
        margin: 0.25em 0 0.5em 0;
        padding-left: 1.5em;
    }

    .markdown-body li {
        margin-bottom: 0.25em;
    }

    .markdown-body h1, .markdown-body h2, .markdown-body h3,
    .markdown-body h4, .markdown-body h5, .markdown-body h6 {
        margin: 0.75em 0 0.25em 0;
        font-weight: 600;
    }

    .markdown-body h1 { font-size: 1.4em; }
    .markdown-body h2 { font-size: 1.25em; }
    .markdown-body h3 { font-size: 1.1em; }

    .markdown-body code {
        background-color: rgba(128, 128, 128, 0.2);
        padding: 0.15em 0.4em;
        border-radius: 4px;
        font-size: 0.9em;
        font-family: 'Cascadia Code', 'Fira Code', monospace;
    }

    .markdown-body pre {
        background-color: rgba(0, 0, 0, 0.3);
        padding: 0.75em 1em;
        border-radius: 6px;
        overflow-x: auto;
        margin: 0.5em 0;
    }

    .markdown-body pre code {
        background: none;
        padding: 0;
    }

    .markdown-body blockquote {
        border-left: 3px solid var(--mud-palette-primary);
        margin: 0.5em 0;
        padding: 0.25em 0.75em;
        opacity: 0.85;
    }

    .markdown-body table {
        border-collapse: collapse;
        margin: 0.5em 0;
        width: 100%;
    }

    .markdown-body th, .markdown-body td {
        border: 1px solid var(--mud-palette-lines-default);
        padding: 0.4em 0.75em;
        text-align: left;
    }

    .markdown-body th {
        font-weight: 600;
        background-color: rgba(128, 128, 128, 0.15);
    }

    .markdown-body a {
        color: var(--mud-palette-primary);
        text-decoration: none;
    }

    .markdown-body a:hover {
        text-decoration: underline;
    }

    .markdown-body strong {
        font-weight: 600;
    }

    .markdown-body hr {
        border: none;
        border-top: 1px solid var(--mud-palette-lines-default);
        margin: 0.75em 0;
    }
</style>

@code {
    [Parameter]
    public int? ConversationId { get; set; }

    private ElementReference _messagesContainer;
    private List<ChatConversationSummaryDto> _conversations = [];
    private ChatConversationDetailDto? _activeConversation;
    private List<ChatMessageDto> _messages = [];
    private List<GroupDto> _myGroups = [];
    private List<string> _availableModels = [];
    private string _selectedModel = "qwen3.5:9b";
    private string _userInput = string.Empty;
    private string _streamingContent = string.Empty;
    private string _searchText = string.Empty;
    private bool _isStreaming;
    private bool _webSearchEnabled = true;
    private bool _docsSearchEnabled = true;
    private bool _sidebarOpen;
    private CancellationTokenSource? _streamCts;

    private IEnumerable<ChatConversationSummaryDto> FilteredConversations =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _conversations
            : _conversations.Where(c =>
                c.Title?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) == true);

    protected override async Task OnInitializedAsync()
    {
        await LoadConversations();
        _myGroups = await GroupSvc.GetMyGroupsAsync();
        _availableModels = await ChatSvc.GetAvailableModelsAsync();

        if (_availableModels.Any() && !_availableModels.Contains(_selectedModel))
            _selectedModel = _availableModels.First();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_isStreaming) return;

        if (ConversationId.HasValue)
        {
            if (_activeConversation?.Id != ConversationId.Value)
                await LoadConversation(ConversationId.Value);
        }
        else
        {
            _activeConversation = null;
            _messages = [];
        }

        // Close sidebar on mobile after selecting a conversation
        _sidebarOpen = false;
    }

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    private async Task LoadConversations()
    {
        _conversations = await ChatSvc.GetConversationsAsync();
    }

    private async Task LoadConversation(int id)
    {
        _activeConversation = await ChatSvc.GetConversationAsync(id);

        if (_activeConversation is not null)
        {
            // Defensive copy — SendMessage mutates _messages directly for optimistic UI updates, and
            // that must not silently alias (and corrupt) _activeConversation's own Messages list.
            _messages = _activeConversation.Messages.ToList();
            _selectedModel = _activeConversation.Model;
        }
        else
        {
            Nav.NavigateTo("/chat");
        }
    }

    private void NewConversation()
    {
        _sidebarOpen = false;
        Nav.NavigateTo("/chat");
    }

    private async Task DeleteConversation(int id)
    {
        await ChatSvc.DeleteConversationAsync(id);
        await LoadConversations();

        if (ConversationId == id)
            Nav.NavigateTo("/chat");
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !_isStreaming)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        var input = _userInput?.Trim();
        if (string.IsNullOrEmpty(input)) return;

        _userInput = string.Empty;
        var isNewConversation = _activeConversation is null;

        // Optimistic: show the user's message immediately (id doesn't matter — it's never referenced
        // again client-side; the full list gets reloaded with real ids once the stream finishes).
        _messages.Add(new ChatMessageDto(0, "user", input, DateTime.UtcNow));

        _isStreaming = true;
        _streamingContent = string.Empty;
        _streamCts = new CancellationTokenSource();
        StateHasChanged();

        var request = new SendChatMessageRequest(input, _selectedModel, _webSearchEnabled, _docsSearchEnabled);
        int? conversationId = _activeConversation?.Id;
        string? wikiTitle = null;
        string? errorMessage = null;

        try
        {
            await foreach (var evt in ChatSvc.SendMessageStreamAsync(conversationId, request, _streamCts.Token))
            {
                switch (evt.Type)
                {
                    case ChatStreamEventType.Token:
                        _streamingContent += evt.Token;
                        StateHasChanged();
                        break;
                    case ChatStreamEventType.Done:
                        conversationId = evt.ConversationId;
                        wikiTitle = evt.WikiArticleCreatedTitle;
                        break;
                    case ChatStreamEventType.Error:
                        conversationId = evt.ConversationId ?? conversationId;
                        errorMessage = evt.ErrorMessage;
                        break;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // User clicked Stop — the server still saves whatever partial content it streamed.
        }
        finally
        {
            _isStreaming = false;
            _streamingContent = string.Empty;
            _streamCts?.Dispose();
            _streamCts = null;
        }

        if (errorMessage is not null)
        {
            Snackbar.Add(errorMessage, Severity.Error);
        }

        if (conversationId is int cid)
        {
            await LoadConversations();
            await LoadConversation(cid);

            if (isNewConversation)
                Nav.NavigateTo($"/chat/{cid}", replace: true);
        }

        if (wikiTitle is not null)
            Snackbar.Add($"Wiki article '{wikiTitle}' created!", Severity.Success);

        StateHasChanged();
    }

    // --- Share dialog ---

    private async Task ShowShareDialog()
    {
        if (_activeConversation is null || !_activeConversation.IsOwnedByCaller) return;

        var parameters = new DialogParameters<ChatShareDialog>
        {
            { x => x.Groups, _myGroups },
            { x => x.CurrentGroupIds, _activeConversation.SharedGroupIds },
            { x => x.ConversationId, _activeConversation.Id }
        };
        var dialog = await DialogService.ShowAsync<ChatShareDialog>("Share Conversation", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadConversation(_activeConversation.Id);
            StateHasChanged();
        }
    }

    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    private static string RenderMarkdown(string markdown)
    {
        if (string.IsNullOrEmpty(markdown)) return string.Empty;
        return Markdown.ToHtml(markdown, MarkdownPipeline);
    }

    private void StopStreaming()
    {
        _streamCts?.Cancel();
    }

    // --- Wiki integration (display-only here — the server creates the article; this just strips the
    // raw [WIKI_CREATE] block from what's shown and offers a manual "Save to Wiki" for any reply) ---

    private static readonly System.Text.RegularExpressions.Regex WikiBlockRegex = new(
        @"\[WIKI_CREATE\]\s*\ntitle:\s*(.+)\ncategory:\s*(.+)\ntags:\s*(.+)\n---\n([\s\S]*?)\[/WIKI_CREATE\]",
        System.Text.RegularExpressions.RegexOptions.Compiled);

    private static bool HasWikiBlock(string content) =>
        content.Contains("[WIKI_CREATE]");

    private static string StripWikiBlocks(string content) =>
        WikiBlockRegex.Replace(content, "").Trim();

    private async Task SaveToWiki(ChatMessageDto msg)
    {
        try
        {
            var title = await ChatSvc.SaveMessageToWikiAsync(msg.Id);
            Snackbar.Add($"Saved to wiki: '{title}'", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    public void Dispose()
    {
        _streamCts?.Cancel();
        _streamCts?.Dispose();
    }
}
