@using BBF.Shared.Contracts.Alerts

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Alert Settings</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
            These are just for you. Alerts arrive between 8am and 9pm.
        </MudText>
        <MudSwitch T="bool" @bind-Value="CategoryLimits" Color="Color.Primary" Label="A category reaches 80% or 100% of its budget" />
        <MudSwitch T="bool" @bind-Value="BillsAndBalance" Color="Color.Primary" Label="A bill is due tomorrow, or checking is about to run low" />
        <MudSwitch T="bool" @bind-Value="Payday" Color="Color.Primary" Label="Payday summary and leftover money" />
        <MudSwitch T="bool" @bind-Value="CategorizeReminder" Color="Color.Primary" Label="Evening reminder when transactions need a category" />
        <MudDivider Class="my-3" />
        <MudSwitch T="bool" @bind-Value="Push" Color="Color.Primary" Label="Send to my phone" />
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
            Off: alerts still show on the Money page, without a phone notification.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool CategoryLimits { get; set; } = true;
    [Parameter] public bool BillsAndBalance { get; set; } = true;
    [Parameter] public bool Payday { get; set; } = true;
    [Parameter] public bool CategorizeReminder { get; set; } = true;
    [Parameter] public bool Push { get; set; } = true;

    private void Cancel() => MudDialog.Cancel();

    private void Submit() => MudDialog.Close(DialogResult.Ok(
        new AlertPreferencesDto(CategoryLimits, BillsAndBalance, Payday, CategorizeReminder, Push)));
}
