@using BBF.Shared.Contracts.Auth
@using BBF.Shared.Contracts.Groups

<MudDialog>
    <DialogContent>
        @* Current members *@
        <MudText Typo="Typo.subtitle2" Class="mb-2">Current Members</MudText>
        @foreach (var member in _members)
        {
            var isCurrentUser = member.UserId == CurrentUserId;
            var currentUserIsOwner = _members.Any(m => m.UserId == CurrentUserId && m.Role == "Owner");

            <MudPaper Class="pa-3 mb-2" Elevation="1">
                <MudStack Row AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.Person"
                             Color="@(member.Role == "Owner" ? Color.Warning : Color.Default)" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body1">
                            @member.UserName
                            @if (isCurrentUser) { <text> (you)</text> }
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @member.Role &middot; Joined @member.JoinedAt.ToLocalTime().ToString("MMM d, yyyy")
                        </MudText>
                    </MudStack>
                    <MudSpacer />
                    @if (currentUserIsOwner && !isCurrentUser)
                    {
                        <MudSelect T="string" Value="@member.Role" ValueChanged="@(r => ChangeRole(member, r))"
                                   Variant="Variant.Outlined" Dense Margin="Margin.Dense"
                                   Style="max-width: 120px;">
                            <MudSelectItem Value="@("Owner")">Owner</MudSelectItem>
                            <MudSelectItem Value="@("Member")">Member</MudSelectItem>
                        </MudSelect>
                        <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Size="Size.Small"
                                       Color="Color.Error" OnClick="@(() => RemoveMember(member))" />
                    }
                </MudStack>
            </MudPaper>
        }

        @* Add member *@
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">Add Member</MudText>
        <MudStack Row AlignItems="AlignItems.End">
            <MudTextField @bind-Value="_addEmail" Label="Email address" Variant="Variant.Outlined"
                          Placeholder="user@example.com" Margin="Margin.Dense" FullWidth />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddMember"
                       Disabled="@string.IsNullOrWhiteSpace(_addEmail)">
                Add
            </MudButton>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public int GroupId { get; set; }
    [Parameter] public string CurrentUserId { get; set; } = string.Empty;

    [Inject] private IGroupService GroupSvc { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private List<GroupMemberDto> _members = [];
    private string _addEmail = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadMembers();
    }

    private async Task LoadMembers()
    {
        var groups = await GroupSvc.GetAllGroupsDetailedAsync();
        var group = groups.FirstOrDefault(g => g.Id == GroupId);
        _members = group?.Members.OrderByDescending(m => m.Role).ThenBy(m => m.JoinedAt).ToList() ?? [];
    }

    private async Task AddMember()
    {
        var email = _addEmail.Trim();
        if (string.IsNullOrEmpty(email)) return;

        try
        {
            var member = await GroupSvc.AddMemberAsync(GroupId, new AddGroupMemberRequest(email));
            _addEmail = string.Empty;
            Snackbar.Add($"Added {member.UserName} to group.", Severity.Success);
            await LoadMembers();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task RemoveMember(GroupMemberDto member)
    {
        await GroupSvc.RemoveMemberAsync(GroupId, member.Id);
        Snackbar.Add($"Removed {member.UserName} from group.", Severity.Info);
        await LoadMembers();
    }

    private async Task ChangeRole(GroupMemberDto member, string newRole)
    {
        await GroupSvc.ChangeMemberRoleAsync(GroupId, member.Id, new ChangeGroupMemberRoleRequest(newRole));
        await LoadMembers();
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
